---
// Plantilla base: estructura común de todas las páginas (cabecera, pie, tema).
import '../estilos/global.css';
import Cabecera from '../componentes/Cabecera.astro';
import Pie from '../componentes/Pie.astro';
import { url } from '../lib/rutas';
import { INDEXAR } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion?: string;
  seccion?: 'inicio' | 'herramientas' | 'prompts' | 'opinion' | 'consensus-qc' | 'planes' | 'acerca' | 'cuenta';
}

const {
  titulo,
  descripcion = 'Herramientas de gestión, calidad y coordinación para tecnólogos médicos de laboratorio clínico. Planillas y plantillas gratuitas.',
  seccion,
} = Astro.props;

const tituloCompleto = titulo === 'ConsensusLab' ? titulo : `${titulo} · ConsensusLab`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {!INDEXAR && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta name="theme-color" content="#4B0B1E" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      // Aplica el tema guardado antes de pintar la página, para evitar parpadeos.
      try {
        var tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera seccion={seccion} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
