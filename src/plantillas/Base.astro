---
// Plantilla base: estructura común de todas las páginas (cabecera, pie, tema).
import '../estilos/global.css';
import Cabecera from '../componentes/Cabecera.astro';
import Pie from '../componentes/Pie.astro';
import Analitica from '../componentes/Analitica.astro';
import AvisoPreventa from '../componentes/AvisoPreventa.astro';
import { url } from '../lib/rutas';
import { FIN_PREVENTA, INDEXAR } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion?: string;
  /** false = la página no se indexa (y queda fuera del sitemap si también se filtra allí). */
  indexar?: boolean;
  /** Datos estructurados (schema.org, JSON-LD) de la página. */
  datos?: Record<string, unknown> | Record<string, unknown>[];
  /** Imagen al compartir (en public/). Por defecto: la de preventa en inicio y planes mientras dure; si no, la del sitio. */
  imagen?: string;
  seccion?: 'inicio' | 'herramientas' | 'calculadoras' | 'prompts' | 'opinion' | 'consensus-qc' | 'planes' | 'acerca' | 'cuenta';
}

const {
  titulo,
  descripcion = 'Herramientas de gestión, calidad y coordinación para profesionales de laboratorio clínico. Planillas y plantillas gratuitas.',
  seccion,
} = Astro.props;

const tituloCompleto = titulo.startsWith('ConsensusLab') ? titulo : `${titulo} · ConsensusLab`;
const indexable = INDEXAR && Astro.props.indexar !== false;
const datos = Astro.props.datos ? [].concat(Astro.props.datos as never) : [];
const jsonLd = (d: unknown) => JSON.stringify(d).replace(/</g, '\\u003c');
const canonica = new URL(Astro.url.pathname, Astro.site);
const enPreventa = new Date().toISOString().slice(0, 10) < FIN_PREVENTA;
const paginaPreventa = Astro.url.pathname === url('') || Astro.url.pathname === url('planes/');
const imagen = new URL(url(Astro.props.imagen ?? (enPreventa && paginaPreventa ? 'og-preventa.png' : 'og-sitio.png')), Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {!indexable && <meta name="robots" content={INDEXAR ? 'noindex, follow' : 'noindex, nofollow'} />}
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content="ConsensusLab" />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ConsensusLab: herramientas de gestión para el laboratorio clínico" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="es_CL" />
    <meta name="theme-color" content="#4B0B1E" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    {datos.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}
    <script is:inline>
      // Canal por el que llegó la visita (enlaces con utm_source), para saber de dónde vienen las cotizaciones.
      try {
        var q = new URLSearchParams(location.search);
        if (q.get('utm_source')) {
          sessionStorage.setItem('origen', (q.get('utm_source') + '/' + (q.get('utm_medium') || '')).replace(/[^a-z0-9_\/-]/gi, '').slice(0, 60));
        }
      } catch (e) {}
      // Aplica el tema guardado antes de pintar la página, para evitar parpadeos.
      try {
        var tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera seccion={seccion} />
    <AvisoPreventa />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <Analitica />
  </body>
</html>
