---
// Invitación a la prueba gratuita (cuenta real, 15 días) desde cualquier página. La cotización vive solo en /planes/laboratorios/.
// variante «caja»: columna lateral · «franja»: ancho completo entre secciones.
import { URL_REGISTRO } from '../lib/sitio';

interface Props {
  variante?: 'caja' | 'franja';
}
const { variante = 'franja' } = Astro.props;
const caja = variante === 'caja';
// Origen de la visita a la app (lo lee el contador del admin como «sitio/<sección>») y evento de conversión.
const seccion = Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'inicio';
const registro = `${URL_REGISTRO}&utm_source=sitio&utm_medium=${encodeURIComponent(seccion)}`;
---

<section class={caja ? 'caja demo-caja' : 'demo-franja'}>
  <div class={caja ? '' : 'contenedor'}>
    <div class={caja ? '' : 'demo-franja-cuerpo demo-franja-sola'}>
      <div class="demo-texto">
        {!caja && <p class="antetitulo">Para tu laboratorio</p>}
        {caja ? <h2>Pruébala en tu laboratorio</h2> : <h2>¿Quieres esto en tu laboratorio?</h2>}
        <p>
          Crea tu cuenta y prueba la app <strong>15 días gratis</strong> con los datos reales de tu laboratorio, sin tarjeta. Si
          contratas, sigues en la misma cuenta con tus registros. Preventa fundadores: <strong>40 % de descuento</strong>
          pagando antes del 1 de diciembre de 2026.
        </p>
        <p><a class="boton boton-primario" href={registro} data-evento="cta_prueba_gratis" data-destino={Astro.url.pathname.replace(/^\/|\/$/g, '') || 'inicio'}>Probar 15 días gratis</a></p>
      </div>
    </div>
  </div>
</section>
