---
// Pie de página: aviso de datos, licencia y enlaces secundarios.
import { getCollection } from 'astro:content';
import { url } from '../lib/rutas';
import { GA_ID } from '../lib/sitio';
const hayOpinion = (await getCollection('opinion')).length > 0;
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie-interior">
    <div>
      <p><strong>ConsensusLab</strong> · Herramientas de gestión para el laboratorio clínico.</p>
      <p>Los recursos son plantillas en blanco o con datos de ejemplo: nunca contienen datos de pacientes.</p>
      <p>
        Recursos gratuitos bajo licencia{' '}
        <a href={url('licencia/')}>CC BY-NC-SA 4.0 con permiso de uso en laboratorios</a>. © {anio}
      </p>
    </div>
    <ul>
      <li><a href={url('herramientas/')}>Herramientas</a></li>
      <li><a href={url('calculadoras/')}>Calculadoras</a></li>
      <li><a href={url('prompts/')}>Prompts de IA</a></li>
      {hayOpinion && <li><a href={url('opinion/')}>Opinión</a></li>}
      <li><a href={url('consensus-qc/')}>Consensus QC</a></li>
      <li><a href={url('planes/')}>Planes</a></li>
      <li><a href={url('acerca/')}>Acerca</a></li>
      <li><a href={url('licencia/')}>Licencia</a></li>
      <li><a href={url('privacidad/')}>Privacidad</a></li>
      <li><a href={url('terminos/')}>Términos</a></li>
      {GA_ID && <li><button type="button" class="enlace-pie" data-preferencias-cookies>Preferencias de cookies</button></li>}
      <li><button type="button" class="enlace-pie" data-reducir-movimiento aria-pressed="false">Reducir animaciones</button></li>
    </ul>
  </div>
</footer>

<script>
  // Interruptor de animaciones (WCAG 2.2.2): complementa la preferencia del sistema y se recuerda en este navegador.
  const raiz = document.documentElement;
  const boton = document.querySelector<HTMLButtonElement>('[data-reducir-movimiento]');
  const sistema = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reflejar = () => {
    const activo = raiz.dataset.movimiento === 'reducido' || sistema;
    boton?.setAttribute('aria-pressed', String(activo));
    if (boton) boton.textContent = activo ? 'Animaciones reducidas' : 'Reducir animaciones';
    if (boton && sistema) boton.disabled = true; // el sistema ya lo pide: no hay nada que cambiar aquí
  };
  reflejar();
  boton?.addEventListener('click', () => {
    const reducir = raiz.dataset.movimiento !== 'reducido';
    if (reducir) raiz.dataset.movimiento = 'reducido';
    else delete raiz.dataset.movimiento;
    try { localStorage.setItem('movimiento', reducir ? 'reducido' : 'normal'); } catch {}
    reflejar();
  });
</script>
