---
// Pie de página: aviso de datos, licencia y enlaces secundarios.
import { getCollection } from 'astro:content';
import { url } from '../lib/rutas';
const hayOpinion = (await getCollection('opinion')).length > 0;
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie-interior">
    <div>
      <p><strong>ConsensusLab</strong> · Herramientas de gestión para el laboratorio clínico.</p>
      <p>Los recursos son plantillas en blanco o con datos de ejemplo: nunca contienen datos de pacientes.</p>
      <p>
        Recursos gratuitos bajo licencia{' '}
        <a href={url('licencia/')}>CC BY-NC-SA 4.0 con permiso de uso en laboratorios</a>. © {anio}
      </p>
    </div>
    <ul>
      <li><a href={url('herramientas/')}>Herramientas</a></li>
      <li><a href={url('calculadoras/')}>Calculadoras</a></li>
      <li><a href={url('prompts/')}>Prompts de IA</a></li>
      {hayOpinion && <li><a href={url('opinion/')}>Opinión</a></li>}
      <li><a href={url('consensus-qc/')}>Consensus QC</a></li>
      <li><a href={url('planes/')}>Planes</a></li>
      <li><a href={url('acerca/')}>Acerca</a></li>
      <li><a href={url('licencia/')}>Licencia</a></li>
      <li><a href={url('privacidad/')}>Privacidad</a></li>
      <li><a href={url('terminos/')}>Términos</a></li>
    </ul>
  </div>
</footer>
