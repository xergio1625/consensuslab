---
// Cabecera con logo, menú principal (plegable en celular) y botón de modo claro/oscuro.
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/rutas';

interface Props {
  seccion?: string;
}
const { seccion } = Astro.props;

// «Guías» y «Opinión» aparecen en el menú solo cuando hay al menos un artículo.
const hayGuias = (await getCollection('guias')).length > 0;
const hayOpinion = (await getCollection('opinion')).length > 0;
// En celular los cinco recursos gratuitos van en un grupo plegable; en pantallas anchas la lista va plana.
const gratis = [
  { id: 'herramientas', texto: 'Herramientas', ruta: 'herramientas/' },
  { id: 'calculadoras', texto: 'Calculadoras', ruta: 'calculadoras/' },
  { id: 'prompts', texto: 'Prompts IA', ruta: 'prompts/' },
  ...(hayGuias ? [{ id: 'guias', texto: 'Guías', ruta: 'guias/' }] : []),
  ...(hayOpinion ? [{ id: 'opinion', texto: 'Opinión', ruta: 'opinion/' }] : []),
];
const resto = [
  { id: 'consensus-qc', texto: 'Consensus QC', ruta: 'consensus-qc/' },
  { id: 'planes', texto: 'Planes', ruta: 'planes/' },
  { id: 'acerca', texto: 'Acerca', ruta: 'acerca/' },
  { id: 'cuenta', texto: 'Ingresar', ruta: 'cuenta/' },
];
const grupoActivo = gratis.some((e) => e.id === seccion);
---

<header class="cabecera">
  <div class="contenedor cabecera-interior">
    <a class="marca" href={url()} aria-label="ConsensusLab, inicio">
      <Logo />
      <span>Consensus<span class="marca-lab">Lab</span></span>
    </a>

    <nav class="nav-principal" aria-label="Navegación principal">
      <ul class="nav-lista" id="menu-principal">
        <li class="nav-grupo">
          <button type="button" class="nav-grupo-boton" aria-expanded={grupoActivo ? 'true' : 'false'} aria-controls="menu-gratis">
            Recursos gratis
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <ul class="nav-sublista" id="menu-gratis">
            {
              gratis.map((e) => (
                <li>
                  <a href={url(e.ruta)} aria-current={seccion === e.id ? 'page' : undefined}>
                    {e.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          resto.map((e) => (
            <li class={'nav-' + e.id}>
              <a href={url(e.ruta)} aria-current={seccion === e.id ? 'page' : undefined}>
                {e.texto}
              </a>
            </li>
          ))
        }
        <li class="nav-tema">
          <button type="button" data-tema>Cambiar entre modo claro y oscuro</button>
        </li>
      </ul>
      <a class="boton boton-dorado boton-demo" href={url('planes/#cotizar')}>Pedir demo</a>
      <button class="boton-icono boton-tema-cabecera" data-tema type="button" aria-label="Cambiar entre modo claro y oscuro">
        <svg class="icono-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="boton-icono boton-menu" id="boton-menu" type="button" aria-controls="menu-principal" aria-expanded="false" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Botón de tema: alterna claro/oscuro y recuerda la elección en este navegador.
  const raiz = document.documentElement;
  document.querySelectorAll('[data-tema]').forEach((boton) =>
    boton.addEventListener('click', () => {
      const actual =
        raiz.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const nuevo = actual === 'dark' ? 'light' : 'dark';
      raiz.dataset.theme = nuevo;
      try {
        localStorage.setItem('tema', nuevo);
      } catch {
        // Sin almacenamiento disponible: el cambio dura hasta recargar.
      }
    }),
  );

  // Grupo «Recursos gratis» del menú móvil.
  const grupoBoton = document.querySelector('.nav-grupo-boton');
  grupoBoton?.addEventListener('click', () => {
    grupoBoton.setAttribute('aria-expanded', String(grupoBoton.getAttribute('aria-expanded') !== 'true'));
  });

  // Menú plegable en celular: se cierra con Esc o al tocar fuera.
  const botonMenu = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-principal');
  const fijarMenu = (abierto: boolean) => {
    menu?.classList.toggle('abierta', abierto);
    botonMenu?.setAttribute('aria-expanded', String(abierto));
    botonMenu?.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  };
  botonMenu?.addEventListener('click', () => fijarMenu(!menu?.classList.contains('abierta')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('abierta')) {
      fijarMenu(false);
      botonMenu?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (menu?.classList.contains('abierta') && !menu.contains(t) && !botonMenu?.contains(t)) fijarMenu(false);
  });
</script>
