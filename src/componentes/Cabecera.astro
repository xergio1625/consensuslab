---
// Cabecera con logo, menú principal (plegable en celular) y botón de modo claro/oscuro.
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/rutas';
import { PROFESSIONAL_ABIERTO, URL_PROFESSIONAL_REGISTRO, URL_REGISTRO } from '../lib/sitio';

interface Props {
  seccion?: string;
}
const { seccion } = Astro.props;

// Tres grupos desplegables: lo gratuito (para todos), el perfil profesional y el de laboratorios (institucional).
// «Planes» abre la vista de cada perfil; «Acerca» e «Ingresar» cuelgan de ambos perfiles.
const comunes = [
  { texto: 'Acerca de', ruta: 'acerca/' },
  { texto: 'Ingresar', ruta: 'cuenta/' },
];
const grupos = [
  {
    id: 'gratis',
    texto: 'Gratis',
    items: [
      { id: 'calculadoras', texto: 'Calculadoras', ruta: 'calculadoras/' },
      { id: 'prompts', texto: 'Prompts de IA', ruta: 'prompts/' },
      { id: 'opinion', texto: 'Opinión', ruta: 'opinion/' },
    ],
    comunes: [],
  },
  {
    id: 'profesional',
    texto: 'Profesional',
    items: [
      { id: 'professional', texto: 'ConsensusLab Professional', ruta: 'professional/' },
      { id: 'guias', texto: 'Guías', ruta: 'guias/' },
      { id: 'planes-pro', texto: 'Planes para profesionales', ruta: 'planes/professional/' },
    ],
    comunes,
  },
  {
    id: 'laboratorios',
    texto: 'Laboratorios',
    items: [
      { id: 'laboratorios', texto: 'Para laboratorios', ruta: 'para-laboratorios/' },
      { id: 'essential', texto: 'Essential', ruta: 'essential/' },
      { id: 'qc', texto: 'ConsensusLab QC', ruta: 'qc/' },
      { id: 'accreditation', texto: 'Accreditation', ruta: 'accreditation/' },
      { id: 'herramientas', texto: 'Herramientas', ruta: 'herramientas/' },
      { id: 'planes-lab', texto: 'Planes para laboratorios', ruta: 'planes/laboratorios/' },
    ],
    comunes,
  },
];
const grupoActivo = (g: (typeof grupos)[number]) => g.items.some((e) => e.id === seccion);
// Botón único según dónde estás: en las páginas de profesionales, Professional; en Accreditation, la lista de espera; en la portada y
// en Planes no hay (ahí ya están las dos puertas y los botones de cada plan).
const secciones_pro = ['professional', 'guias', 'planes-pro'];
const cta = secciones_pro.includes(seccion ?? '')
  ? (PROFESSIONAL_ABIERTO ? { texto: 'Probar Professional', href: URL_PROFESSIONAL_REGISTRO } : { texto: 'Quiero entrar primero', href: '#novedades' })
  : seccion === 'accreditation' ? { texto: 'Sumarme a la lista', href: '#novedades' }
  : seccion === 'inicio' || seccion === 'planes' || seccion === 'planes-lab' ? null : { texto: 'Probar gratis', href: URL_REGISTRO };
---

<header class="cabecera">
  <div class="contenedor cabecera-interior">
    <a class="marca" href={url()} aria-label="ConsensusLab, inicio">
      <Logo />
      <span>Consensus<span class="marca-lab">Lab</span></span>
    </a>

    <nav class="nav-principal" aria-label="Navegación principal">
      <ul class="nav-lista" id="menu-principal">
        {
          grupos.map((g) => (
            <li class={'nav-grupo' + (g.id === 'laboratorios' ? ' nav-grupo-der' : '')}>
              <button type="button" class={'nav-grupo-boton' + (grupoActivo(g) ? ' activo' : '')} aria-expanded="false" aria-controls={`menu-${g.id}`}>
                {g.texto}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
              </button>
              <ul class="nav-sublista" id={`menu-${g.id}`}>
                {g.items.map((e) => (
                  <li>
                    <a href={url(e.ruta)} aria-current={seccion === e.id ? 'page' : undefined}>{e.texto}</a>
                  </li>
                ))}
                {g.comunes.map((e, i) => (
                  <li class={i === 0 ? 'nav-sep' : undefined}>
                    <a href={url(e.ruta)}>{e.texto}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
        <li class="nav-tema">
          <button type="button" data-tema>Cambiar entre modo claro y oscuro</button>
        </li>
      </ul>
      {cta && <a class="boton boton-dorado boton-demo" href={cta.href}>{cta.texto}</a>}
      <button class="boton-icono boton-tema-cabecera" data-tema type="button" aria-label="Cambiar entre modo claro y oscuro">
        <svg class="icono-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="boton-icono boton-menu" id="boton-menu" type="button" aria-controls="menu-principal" aria-expanded="false" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Botón de tema: alterna claro/oscuro y recuerda la elección en este navegador.
  const raiz = document.documentElement;
  document.querySelectorAll('[data-tema]').forEach((boton) =>
    boton.addEventListener('click', () => {
      const actual =
        raiz.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const nuevo = actual === 'dark' ? 'light' : 'dark';
      raiz.dataset.theme = nuevo;
      try {
        localStorage.setItem('tema', nuevo);
      } catch {
        // Sin almacenamiento disponible: el cambio dura hasta recargar.
      }
    }),
  );

  // Grupos del menú: se abren de a uno; se cierran con Esc o al tocar fuera.
  const gruposBoton = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-grupo-boton'));
  const cerrarGrupos = (menos?: HTMLElement | null) =>
    gruposBoton.forEach((b) => { if (b !== menos) b.setAttribute('aria-expanded', 'false'); });
  gruposBoton.forEach((b) =>
    b.addEventListener('click', () => {
      const abrir = b.getAttribute('aria-expanded') !== 'true';
      cerrarGrupos(b);
      b.setAttribute('aria-expanded', String(abrir));
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarGrupos();
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav-grupo')) cerrarGrupos();
  });

  // Menú plegable en celular: se cierra con Esc o al tocar fuera.
  const botonMenu = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-principal');
  const fijarMenu = (abierto: boolean) => {
    menu?.classList.toggle('abierta', abierto);
    botonMenu?.setAttribute('aria-expanded', String(abierto));
    botonMenu?.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  };
  botonMenu?.addEventListener('click', () => fijarMenu(!menu?.classList.contains('abierta')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('abierta')) {
      fijarMenu(false);
      botonMenu?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (menu?.classList.contains('abierta') && !menu.contains(t) && !botonMenu?.contains(t)) fijarMenu(false);
  });
</script>
