---
// Medición del sitio: solo Cloudflare Web Analytics, sin cookies ni identificadores (por eso carga sin pedir consentimiento).
// Google Analytics y el aviso de cookies se retiraron el 14-11-2026. El seguimiento de conversiones vive en la app:
// visitas al registro con su origen y campaña, suscripciones (con la página), cotizaciones y pedidos.
import { CF_BEACON_TOKEN } from '../lib/sitio';
---

{CF_BEACON_TOKEN && (
  <script is:inline type="module" defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}></script>
)}
