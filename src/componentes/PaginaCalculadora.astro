---
// Estructura común de una calculadora: migas, encabezado, aviso de privacidad, el formulario
// (slot por defecto), la explicación (slot «explicacion») y el lateral con otras calculadoras.
import Base from '../plantillas/Base.astro';
import PedirDemo from './PedirDemo.astro';
import { CALCULADORAS, GRUPOS_ESTADISTICA, calculadora, type IdCalculadora } from '../lib/calculadoras';
import { migasLd, url } from '../lib/rutas';

interface Props {
  id: IdCalculadora;
}
const c = calculadora(Astro.props.id);
const grupoDe = (x: { grupo?: string }) => x.grupo;
const grupoEst = c.familia === 'estadistica' ? GRUPOS_ESTADISTICA.find((g) => g.id === grupoDe(c)) : undefined;
const otras = CALCULADORAS.filter((o) => o.id !== c.id).sort(
  (a, b) =>
    Number(b.familia === c.familia) - Number(a.familia === c.familia) ||
    Number(c.familia === 'estadistica' && grupoDe(b) === grupoDe(c)) - Number(c.familia === 'estadistica' && grupoDe(a) === grupoDe(c)),
);
---

<Base
  titulo={`${c.titulo}: calculadora para laboratorio clínico`}
  seccion="calculadoras"
  descripcion={`Calculadora gratuita para laboratorio clínico. ${c.resumen}`}
  datos={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: c.titulo,
      description: c.resumen,
      url: new URL(Astro.url.pathname, Astro.site).href,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      inLanguage: 'es',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'CLP' },
    },
    migasLd(Astro.site, [['Calculadoras', 'calculadoras/'], [c.titulo, Astro.url.pathname.replace(/^\//, '')]]),
  ]}
>
  <div class="contenedor">
    <nav class="migas" aria-label="Ruta de navegación">
      <ol>
        <li><a href={url('calculadoras/')}>Calculadoras</a></li>
        <li aria-current="page">{c.titulo}</li>
      </ol>
    </nav>

    <header class="ficha-cabeza">
      {
        grupoEst && (
          <p class="calc-kicker">
            <a href={url('calculadoras/pruebas-estadisticas/')}>Pruebas estadísticas</a> · {grupoEst.titulo}: <em>{grupoEst.pregunta}</em>
          </p>
        )
      }
      <h1>{c.titulo}</h1>
      <p>{c.resumen}</p>
    </header>

    <div class="ficha">
      <article class="ficha-cuerpo">
        <div class="aviso aviso-info">
          {
            c.familia === 'resultados' ? (
              <p>
                El cálculo se hace en tu navegador: no se envía ni se guarda nada. Ingresa solo valores numéricos, sin
                nombres, RUT ni otros identificadores. Es una herramienta de verificación y apoyo: no reemplaza el
                informe validado ni el criterio profesional.
              </p>
            ) : (
              <p>
                El cálculo se hace en tu navegador: no se envía ni se guarda nada. Usa resultados de control o de
                control externo, nunca datos de pacientes.
              </p>
            )
          }
        </div>
        <slot />
        <slot name="explicacion" />
      </article>

      <aside class="ficha-lateral" aria-label="Más calculadoras">
        {
          c.familia === 'costos' ? (
            <section class="caja caja-app">
              <h2>Del cálculo al costeo continuo</h2>
              <p>
                La ficha Costeo por examen llevará este cálculo a tus compras y tu producción reales, mes a mes, para ver
                qué exámenes pierden dinero.
              </p>
              <p><a class="boton boton-primario boton-ancho" href={url('herramientas/costeo-por-examen/')}>Ver la ficha</a></p>
            </section>
          ) : c.familia === 'insumos' ? (
            <section class="caja caja-app">
              <h2>Pedido sugerido automático</h2>
              <p>
                Inventario y lotes de reactivos lleva el stock por lote con su mínimo, avisa los vencimientos y las
                alertas de quiebre, y arma el pedido sugerido para la solicitud de compra.
              </p>
              <p><a class="boton boton-primario boton-ancho" href={url('herramientas/inventario-y-lotes-de-reactivos/')}>Ver la ficha</a></p>
            </section>
          ) : c.familia === 'calidad' ? (
            <section class="caja caja-app">
              <h2>Automático en Consensus QC</h2>
              <p>
                Consensus QC calcula cada mes el CV, el sesgo, el error total y la sigma de cada analizador con tus controles
                y tu control externo, y los compara con el plan de calidad.
              </p>
              <p><a class="boton boton-primario boton-ancho" href={url('consensus-qc/')}>Conocer Consensus QC</a></p>
            </section>
          ) : c.familia === 'estadistica' ? (
            <section class="caja caja-app">
              <h2>¿Qué prueba uso?</h2>
              <p>
                Cada prueba responde una pregunta distinta. La guía las ordena por la decisión que quieres tomar y
                explica en qué se parecen y en qué se confunden.
              </p>
              <p><a class="boton boton-primario boton-ancho" href={url('calculadoras/pruebas-estadisticas/')}>Ver la guía de pruebas</a></p>
            </section>
          ) : c.familia === 'indicadores' ? (
            <section class="caja caja-app">
              <h2>Del cálculo al informe mensual</h2>
              <p>
                Informes mensuales automáticos reúne producción, consumo, costos e indicadores, y los envía por correo
                al jefe o a la dirección.
              </p>
              <p><a class="boton boton-primario boton-ancho" href={url('herramientas/informes-mensuales-automaticos/')}>Ver la ficha</a></p>
            </section>
          ) : c.familia === 'resultados' ? (
            <section class="caja caja-app">
              <h2>Verifica y deja registro</h2>
              <p>
                Consensus QC lleva el control de calidad y el cambio crítico de cada analizador. Para dejar evidencia
                trazable de tus verificaciones, conoce el plan Gestión.
              </p>
              <p><a class="boton boton-primario boton-ancho" href={url('consensus-qc/')}>Conocer Consensus QC</a></p>
            </section>
          ) : null
        }
        <PedirDemo variante="caja" />
        <section class="caja">
          <h2>Otras calculadoras</h2>
          <ul class="lista-simple">
            {otras.map((o) => <li><a href={url(`calculadoras/${o.id}/`)}>{o.titulo}</a></li>)}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<script>
  // Destello en las cifras de resultado cuando cambian (sin tocar el script de cada calculadora).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && document.documentElement.dataset.movimiento !== 'reducido') {
    const previo = new WeakMap<Element, string>();
    const marcar = (caja: Element) => {
      caja.querySelectorAll('.calc-cifras > div').forEach((c) => {
        const txt = c.textContent ?? '';
        if (previo.has(c) && previo.get(c) !== txt) {
          c.classList.remove('calc-actualizado');
          void (c as HTMLElement).offsetWidth;
          c.classList.add('calc-actualizado');
        }
        previo.set(c, txt);
      });
    };
    document.querySelectorAll('.calc-resultado').forEach((caja) => {
      marcar(caja);
      new MutationObserver(() => marcar(caja)).observe(caja, { childList: true, characterData: true, subtree: true });
    });
  }
</script>
