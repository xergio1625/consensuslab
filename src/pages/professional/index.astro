---
// ConsensusLab Professional: página de venta. La app vive en app.consensuslab.cl/professional.
// Mientras PROFESSIONAL_ABIERTO sea false, los botones llevan a la lista de espera (formulario de novedades del pie).
import Base from '../../plantillas/Base.astro';
import { url } from '../../lib/rutas';
import {
  MESES_PRUEBA_PROFESSIONAL,
  PRECIO_PROFESSIONAL,
  PRECIO_PROFESSIONAL_TEXTO,
  PROFESSIONAL_ABIERTO,
  URL_APP,
  URL_PROFESSIONAL_REGISTRO,
} from '../../lib/sitio';

const entrar = PROFESSIONAL_ABIERTO
  ? { texto: `Probar ${MESES_PRUEBA_PROFESSIONAL} meses gratis`, href: URL_PROFESSIONAL_REGISTRO }
  : { texto: 'Quiero entrar primero', href: '#novedades' };

const pasos = [
  ['Se abre la ronda', 'Cada ronda abre y cierra en fechas fijas, como un control externo de laboratorio: una vez al mes o cada tres meses.'],
  ['Decides primero', 'Ves un caso con su gráfica de control y eliges qué harías. Puedes explicarlo en una frase. No se puede cambiar después.'],
  ['Ves la respuesta experta', 'Recién al responder aparece el razonamiento experto y cómo quedó tu decisión: experta, aceptable o no recomendada.'],
  ['Comparas con el grupo', 'Al cierre se publica cómo decidió el resto, de forma anónima. Tu laboratorio ve su propio resultado desde 5 personas.'],
];

// Lo que la plataforma tiene hoy, por área. No agregar aquí nada que aún no exista.
const areas = [
  {
    id: 'rondas',
    titulo: 'Rondas de criterio',
    frase: 'Decide primero, compara después.',
    puntos: [
      'Casos de control de calidad con gráficas de Westgard y respuesta experta.',
      'Resultados anónimos del grupo al cierre de cada ronda.',
      'Certificado de participación con código verificable.',
    ],
  },
  {
    id: 'rutas',
    titulo: 'Rutas por situación',
    frase: 'Cuéntale qué te pasa y te ordena qué hacer.',
    puntos: [
      '24 rutas: control rechazado, analizador nuevo, cambio de método o proveedor, dos equipos que deben dar lo mismo, no conformidades, compras y rutinas.',
      'Pasos en orden, la estadística que corresponde y la calculadora para hacerla.',
      'Guardas el resultado en tu cuaderno.',
    ],
  },
  {
    id: 'herramientas',
    titulo: 'Herramientas de trabajo',
    frase: 'Para el mesón y para microbiología.',
    puntos: [
      'Piano hematológico: recuento diferencial con el teclado.',
      'Identificación bacteriana con 5 tubos.',
      'Antibiograma de cocos grampositivos y bacilos gramnegativos, con los puntos de corte de tu laboratorio.',
    ],
  },
  {
    id: 'portafolio',
    titulo: 'Portafolio y desarrollo',
    frase: 'Tu carrera en una sola cuenta.',
    puntos: [
      'Guardas tus títulos, cursos y capacitaciones; los certificados de las rondas llegan solos.',
      'Autoevaluación por áreas que te muestra qué reforzar.',
      'Registro de horas de formación por año, listo para tu currículum.',
      'Cuaderno de decisiones y pendientes, y un calendario. Todo es solo tuyo.',
    ],
  },
  {
    id: 'biblioteca',
    titulo: 'Biblioteca',
    frase: 'Guías y planillas para el trabajo diario.',
    puntos: [
      'Guías en PDF y planillas de Excel, como verificar un método o qué hacer cuando un control se sale.',
      'Una pieza nueva cada dos meses.',
    ],
  },
  {
    id: 'laboratorio',
    titulo: 'Conecta con tu laboratorio',
    frase: 'Tu cuenta es tuya, estés donde estés.',
    puntos: [
      'Si tu laboratorio te lo pide, entregas documentos de tu portafolio con tu consentimiento.',
      'Acceso directo a ConsensusLab Essential cuando tu laboratorio lo tiene.',
      'Cada plan de laboratorio incluye hasta 5 cuentas de Professional.',
    ],
  },
];

const herramientas = [
  ['Piano hematológico', 'Cuentas el recuento diferencial con el teclado, con las ocho líneas en el orden clásico. Suena una alarma al completar el recuento y obtienes el informe en ese mismo orden.', 'professional/piano-hematologico/'],
  ['Identificación bacteriana', 'Anotas lo que ves en los cinco tubos (TSI, LIA, MIO, citrato y urea) y la herramienta reparte la confianza entre las bacterias posibles. Es una ayuda para ordenar la decisión, no una identificación definitiva.', 'professional/identificacion-bacteriana/'],
  ['Antibiograma', 'Según el organismo y el sitio de la muestra, te sugiere qué antibióticos probar e interpreta los halos con los puntos de corte que tú declaras desde la tabla vigente de tu laboratorio. No guardamos los halos.', 'professional/antibiograma/'],
];

const incluye = [
  'Rondas de control externo del criterio profesional, con casos de control de calidad y gráficas de Westgard.',
  'Respuesta experta con su razonamiento, resultados del grupo al cierre y certificado de participación por ronda.',
  '24 rutas por situación, piano hematológico, identificación bacteriana y antibiograma.',
  'Portafolio personal con autoevaluación, cuaderno y calendario.',
  'Biblioteca de guías y planillas de Excel, con una pieza nueva cada dos meses (al menos 6 al año). Cada guía suelta cuesta $2.900.',
  'Tu historial de decisiones, siempre privado.',
];

const preguntas = [
  ['¿Me evalúan o me ponen nota?', 'No. Es un ejercicio de criterio, no un examen ni una certificación de competencias. El certificado acredita que participaste.'],
  ['¿Alguien ve qué decidí yo?', 'No. Tu decisión es privada. Los resultados se publican siempre agrupados: ni tu laboratorio ni otras personas ven qué eligió cada quien. Por eso el desglose de un laboratorio aparece solo desde 5 personas.'],
  ['¿Los casos son de pacientes reales?', 'No. Son casos compuestos, sin datos de pacientes ni de laboratorios identificables. En tu laboratorio siempre manda tu procedimiento aprobado.'],
  ['¿Quién decide cuál es la respuesta experta?', 'Cada caso lo redacta un tecnólogo médico y lo revisan otras personas del área antes de publicarse. Cuando la conducta depende del procedimiento del laboratorio, el caso lo dice en su supuesto y se aceptan respuestas razonables además de la experta.'],
  ['Si mi laboratorio usa ConsensusLab, ¿pierdo mi cuenta al cambiar de trabajo?', 'No. Tu cuenta es tuya: si tu laboratorio te invita, la aceptas y entras con la misma cuenta; si cambias de trabajo, sales del laboratorio y conservas tu perfil y tu historial. Los planes de laboratorio incluyen hasta 5 cuentas de Professional.'],
  ['¿Qué hay en la biblioteca y puedo descargarla durante la prueba?', 'Son guías prácticas en PDF y planillas de Excel (por ejemplo, verificar un método o qué hacer cuando un control se sale), con una pieza nueva cada dos meses. Cada PDF lleva tu nombre al pie y es de uso personal. Las descargas completas son para quienes tienen la suscripción pagada (o el cupo de un laboratorio); durante los 3 meses gratis ves el índice y las dos primeras páginas de cada guía.'],
  ['¿Qué es el portafolio y quién lo ve?', 'Es tu espacio para guardar títulos, cursos, certificados, autoevaluaciones y notas. Es privado: nadie lo ve salvo que tú entregues un documento a un laboratorio que te lo pida, con tu consentimiento expreso. Lo que entregas pasa a ser parte del registro de ese laboratorio y no se puede retirar, porque la acreditación exige que el laboratorio conserve el registro de su personal.'],
  ['¿La autoevaluación me evalúa o me certifica?', 'No. Es una guía privada para ver en qué áreas conviene reforzar y te sugiere calculadoras, guías o rondas. No genera ningún certificado.'],
  ['¿Las rutas por situación son protocolos?', 'No. Son una ayuda para ordenar los pasos y elegir la estadística adecuada. En tu laboratorio siempre manda tu procedimiento aprobado.'],
  ['¿El antibiograma trae los puntos de corte?', 'No. Tú declaras los de la tabla vigente de tu laboratorio (CLSI, EUCAST u otra). Así usas siempre tu edición y no reproducimos tablas protegidas por derechos de autor.'],
  ['¿La identificación bacteriana es definitiva?', 'No. Reparte la confianza entre las bacterias de la lista según lo que ves en los tubos y nunca llega al 100 %. Salmonella y Shigella, por ejemplo, siempre se confirman con serología.'],
  ['¿Guardan los halos, los recuentos o los resultados de los tubos?', 'No. Se calculan al momento y no se guardan. Tampoco debes escribir datos de pacientes.'],
  ['¿Necesito ConsensusLab Essential para usar Professional?', 'No. Professional funciona solo. El acceso directo a Essential se activa si tu laboratorio tiene ese servicio.'],
  ['¿Qué pasa cuando terminan los 3 meses?', `Para continuar pagas la anualidad (${PRECIO_PROFESSIONAL_TEXTO} con IVA incluido), a contar desde la fecha de pago. No hay renovación automática: te avisamos antes de que venza. Si no continúas, por 30 días puedes consultar tu historial.`],
  ['¿Sirve si trabajo fuera de Chile?', 'Sí. Los casos usan criterios internacionales de control de calidad (reglas de Westgard, CLSI) y no dependen de una norma nacional. Por ahora el precio y el pago son en pesos chilenos; si estás en otro país, escríbenos a contacto@consensuslab.cl y te contamos cómo pagar.'],
  ['¿Cómo pago y qué recibo?', 'Por transferencia, y te emitimos boleta electrónica. Si necesitas factura para tu institución, escríbenos a contacto@consensuslab.cl.'],
];
---

<Base
  titulo="ConsensusLab Professional · tu escritorio profesional de laboratorio clínico"
  seccion="professional"
  descripcion={`Rondas de criterio con gráficas de Westgard, 24 rutas para cada situación del laboratorio, piano hematológico, identificación bacteriana, antibiograma y tu portafolio profesional. ${MESES_PRUEBA_PROFESSIONAL} meses gratis.`}
  datos={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'ConsensusLab Professional',
      description: 'Escritorio profesional para personal de laboratorio clínico de habla hispana: rondas de control externo del criterio con gráficas de control, 24 rutas por situación, piano hematológico, identificación bacteriana, antibiograma, portafolio con autoevaluación y biblioteca de guías y planillas.',
      featureList: areas.map((x) => x.titulo),
      brand: { '@type': 'Brand', name: 'ConsensusLab' },
      url: new URL('professional/', Astro.site).href,
      offers: {
        '@type': 'Offer',
        price: String(PRECIO_PROFESSIONAL),
        priceCurrency: 'CLP',
        availability: PROFESSIONAL_ABIERTO ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
        url: new URL('professional/', Astro.site).href,
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: preguntas.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ]}
>
  <section class="portada">
    <div class="portada-fondo" aria-hidden="true"></div>
    <div class="contenedor">
      <p class="antetitulo">Para profesionales de laboratorio clínico</p>
      <h1>Tu escritorio profesional de laboratorio clínico</h1>
      <p class="portada-lema">
        Rondas de criterio, rutas para cada situación, herramientas de trabajo y un portafolio que te acompaña si cambias
        de laboratorio. Todo en una cuenta personal.
      </p>
      <div class="acciones-portada">
        <a class="boton boton-dorado" href={entrar.href}>{entrar.texto}</a>
        <a class="boton boton-secundario boton-claro" href="#dentro">Ver qué hay adentro</a>
      </div>
      <p class="nota-portada">
        {PRECIO_PROFESSIONAL_TEXTO} al año, IVA incluido · {MESES_PRUEBA_PROFESSIONAL} meses gratis, sin tarjeta · sin renovación automática.
        {!PROFESSIONAL_ABIERTO && <span> Abre pronto: deja tu correo y te avisamos primero.</span>}
      </p>
    </div>
  </section>

  <section class="seccion" id="dentro">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <p class="antetitulo">Qué hay adentro</p>
          <h2>Seis áreas, una sola cuenta</h2>
        </div>
      </div>
      <div class="rejilla">
        {
          areas.map((a) => (
            <div class="tarjeta" id={a.id}>
              <h3>{a.titulo}</h3>
              <p><strong>{a.frase}</strong></p>
              <ul class="lista-tarjeta">
                {a.puntos.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion seccion-alt" id="herramientas-detalle">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <p class="antetitulo">Herramientas de trabajo</p>
          <h2>Para el mesón y para microbiología</h2>
        </div>
      </div>
      <div class="rejilla">
        {
          herramientas.map(([titulo, texto, ruta]) => (
            <div class="tarjeta">
              <h3><a href={url(ruta)}>{titulo}</a></h3>
              <p>{texto}</p>
            </div>
          ))
        }
      </div>
      <p class="texto-suave" style="margin-top:14px">
        Estas secciones están en afinación continua. Ayudan a contar, ordenar e interpretar; no reemplazan el juicio del
        profesional ni el procedimiento de tu laboratorio.
      </p>
    </div>
  </section>

  <section class="seccion" id="como">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <p class="antetitulo">Rondas de criterio</p>
          <h2>Una ronda en cuatro pasos</h2>
        </div>
      </div>
      <ol class="pasos">
        {
          pasos.map(([titulo, texto], i) => (
            <li class="paso">
              <span class="paso-num">{i + 1}</span>
              <h3>{titulo}</h3>
              <p>{texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <p class="antetitulo">Qué incluye</p>
          <h2>Lo que obtienes con tu cuenta</h2>
        </div>
      </div>
      <ul class="prosa" style="padding:0 0 0 1.2em">
        {incluye.map((t) => <li>{t}</li>)}
      </ul>
      <div class="aviso aviso-info">
        <p>
          <strong>Lo que no es:</strong> no es un examen ni una certificación de competencias; el certificado acredita participación, no un título ni una capacitación acreditada. Tu resultado individual no
          se usa para evaluar ni sancionar a nadie. En tu laboratorio manda tu procedimiento aprobado.
        </p>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <p class="antetitulo">Precio</p>
          <h2>Un año, un solo pago</h2>
        </div>
      </div>
      <div class="precio-bloque">
        <p class="precio-grande">{PRECIO_PROFESSIONAL_TEXTO}</p>
        <p>al año, IVA incluido, a contar desde la fecha de pago.</p>
        <p><strong>{MESES_PRUEBA_PROFESSIONAL} meses gratis</strong> para probar, sin tarjeta y sin compromiso.</p>
        <p class="texto-suave">Sin renovación automática. Te emitimos boleta electrónica.</p>
        <p style="margin-top:10px"><a class="boton boton-primario" href={entrar.href}>{entrar.texto}</a></p>
      </div>
      <p class="texto-suave" style="margin-top:14px">
        ¿Tu laboratorio usa o quiere usar ConsensusLab? Cada plan de laboratorio incluye hasta 5 cuentas de Professional para
        su equipo: <a href={url('planes/laboratorios/')}>mira los planes</a>.
      </p>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor prosa">
      <h2>Preguntas frecuentes</h2>
      {
        preguntas.map(([q, a]) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))
      }
      <p class="texto-suave">
        Se ingresa siempre por {URL_APP.replace('https://', '').replace(/\/$/, '')}: es el mismo acceso para Professional y para los laboratorios. Quien dirige un laboratorio puede
        ver <a href={url('para-laboratorios/')}>ConsensusLab para laboratorios</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .lista-tarjeta { margin: 0; padding-left: 1.15em; display: grid; gap: 6px; color: var(--c-texto-suave); font-size: .95rem; }
</style>
