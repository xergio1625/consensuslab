---
// Portada de ConsensusLab: dos puertas. Una para profesionales de laboratorio (ConsensusLab Professional) y otra para
// quien dirige o gestiona un laboratorio (Para laboratorios: Essential, QC y Accreditation). Lo gratuito y la opinión
// van debajo. La propuesta completa para laboratorios vive en /para-laboratorios/.
import Base from '../plantillas/Base.astro';
import { obtenerCatalogo, obtenerOpinion, obtenerPrompts } from '../lib/datos';
import { formatoFecha, url } from '../lib/rutas';
import { CALCULADORAS } from '../lib/calculadoras';
import { CORREO_CONTACTO, LINKEDIN_PERFIL, MESES_PRUEBA_PROFESSIONAL, PRECIO_PROFESSIONAL_TEXTO } from '../lib/sitio';

const catalogo = await obtenerCatalogo();
const totalHerramientas = catalogo.reduce((n, { herramientas }) => n + herramientas.length, 0);
const totalPrompts = (await obtenerPrompts()).length;
const ultimos = (await obtenerOpinion()).slice(0, 3);
---

<Base
  titulo="ConsensusLab: criterio y gestión para el laboratorio clínico"
  descripcion="ConsensusLab Professional para profesionales de laboratorio y software de calidad y gestión para laboratorios, sin conflicto de interés. Calculadoras gratis."
  seccion="inicio"
  datos={[
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'ConsensusLab',
      url: Astro.site?.href,
      logo: new URL('logo.png', Astro.site).href,
      email: CORREO_CONTACTO,
      areaServed: ['CL', 'AR', 'PE', 'CO', 'EC', 'PY', 'UY', 'BO', 'MX', 'ES'],
      description: 'Criterio y gestión para el laboratorio clínico: ConsensusLab Professional para profesionales y software de calidad y gestión para laboratorios, independiente de proveedores de controles, equipos y reactivos, con calculadoras y guías gratuitas.',
      founder: {
        '@type': 'Person',
        name: 'Sergio Inostroza Riffo',
        jobTitle: 'Tecnólogo médico',
        url: new URL('acerca/', Astro.site).href,
        sameAs: [LINKEDIN_PERFIL],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ConsensusLab',
      url: Astro.site?.href,
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: new URL('herramientas/?q={search_term_string}', Astro.site).href },
        'query-input': 'required name=search_term_string',
      },
    },
  ]}
>
  <section class="portada portada-compacta">
    <div class="portada-fondo" aria-hidden="true">
      <!-- Gráfica de control (Levey-Jennings) decorativa: la serie se traza, deriva y dispara la alerta de la regla 2s. -->
      <div class="portada-grafica">
        <svg viewBox="0 0 800 240" preserveAspectRatio="xMaxYMin meet" focusable="false">
          <line class="pg-limite" x1="0" y1="30" x2="800" y2="30" />
          <line class="pg-limite" x1="0" y1="60" x2="800" y2="60" />
          <line class="pg-media" x1="0" y1="120" x2="800" y2="120" />
          <line class="pg-limite" x1="0" y1="180" x2="800" y2="180" />
          <line class="pg-limite" x1="0" y1="210" x2="800" y2="210" />
          <polyline class="pg-linea" pathLength="1" points="40,118 88,104 136,131 184,112 232,97 280,124 328,140 376,109 424,98 472,115 520,92 568,84 616,72 664,58 712,46 760,38" />
          {
            [[40,118],[88,104],[136,131],[184,112],[232,97],[280,124],[328,140],[376,109],[424,98],[472,115],[520,92],[568,84],[616,72]].map(([x, y], i) => (
              <circle class="pg-punto" cx={x} cy={y} r="4" style={`--i:${i}`} />
            ))
          }
          <circle class="pg-punto" cx="664" cy="58" r="5.5" style="--i:13" />
          <circle class="pg-punto" cx="712" cy="46" r="5.5" style="--i:14" />
          <circle class="pg-punto" cx="760" cy="38" r="5.5" style="--i:15" />
          <circle class="pg-alerta" cx="760" cy="38" r="8" />
        </svg>
      </div>
    </div>
    <div class="contenedor">
      <div class="portada-cabeza">
        <div>
          <p class="antetitulo">Laboratorio clínico</p>
          <h1>Criterio y gestión para el laboratorio clínico</h1>
        </div>
        <p class="portada-lema">
          Dos formas de hacerlo mejor, según desde dónde trabajas. Hecho por un tecnólogo médico, sin conflicto de interés:
          no vendemos controles, analizadores, equipos ni reactivos.
        </p>
      </div>

      <div class="puertas" id="puertas">
        <article class="puerta puerta-destacada">
          <p class="antetitulo">Soy profesional de laboratorio</p>
          <h2>ConsensusLab Professional</h2>
          <p>
            Pon a prueba tu criterio en rondas de control externo: decides frente a una gráfica de control, ves la
            respuesta experta y comparas, de forma anónima, con el resto del grupo.
          </p>
          <ul>
            <li>Rondas con fechas fijas, como un control externo de laboratorio</li>
            <li>Certificado de participación que se puede verificar</li>
            <li>Una sola cuenta: te acompaña si cambias de trabajo</li>
          </ul>
          <p class="puerta-precio">{PRECIO_PROFESSIONAL_TEXTO} al año, IVA incluido · {MESES_PRUEBA_PROFESSIONAL} meses gratis</p>
          <div class="acciones-portada">
            <a class="boton boton-primario" href={url('professional/')}>Conocer Professional</a>
            <a class="boton boton-secundario" href={url('guias/')}>Ver las guías</a>
          </div>
        </article>

        <article class="puerta">
          <p class="antetitulo">Dirijo o gestiono un laboratorio</p>
          <h2>ConsensusLab para laboratorios</h2>
          <p>
            Lleva tu plan de calidad al trabajo de cada turno y mira si se cumple: Essential para la gestión del
            laboratorio y ConsensusLab QC para el control de calidad.
          </p>
          <ul>
            <li>Prueba gratis 15 días con los datos reales de tu laboratorio</li>
            <li>Essential, ConsensusLab QC o los dos juntos</li>
            <li>Cada plan incluye hasta 5 cuentas de Professional para tu equipo</li>
          </ul>
          <p class="puerta-precio">Planes anuales desde la preventa de fundadores</p>
          <div class="acciones-portada">
            <a class="boton boton-primario" href={url('para-laboratorios/')}>Ver para laboratorios</a>
            <a class="boton boton-secundario" href={url('diagnostico/')}>Haz el diagnóstico</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="cifras" aria-label="El sitio en cifras">
    <div class="contenedor cifras-fila">
      <p><strong data-count={totalHerramientas}>{totalHerramientas}</strong> herramientas de gestión</p>
      <p><strong data-count={CALCULADORAS.length}>{CALCULADORAS.length}</strong> calculadoras gratuitas</p>
      <p><strong data-count={totalPrompts}>{totalPrompts}</strong> prompts de IA</p>
      <p><strong>0</strong> datos de pacientes</p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <p class="antetitulo">Gratis, sin crear cuenta</p>
          <h2>Para empezar hoy</h2>
        </div>
      </div>
      <div class="rejilla">
        <article class="tarjeta">
          <h3><a href={url('calculadoras/')}>Calculadoras</a></h3>
          <p>{CALCULADORAS.length} calculadoras de calidad, estadística de control, costos y trabajo en el banco. Funcionan en tu navegador.</p>
        </article>
        <article class="tarjeta">
          <h3><a href={url('herramientas/')}>Herramientas de gestión</a></h3>
          <p>{totalHerramientas} planillas y fichas para continuidad, insumos, personal y calidad del laboratorio.</p>
        </article>
        <article class="tarjeta">
          <h3><a href={url('diagnostico/')}>Diagnóstico de tu laboratorio</a></h3>
          <p>12 preguntas, 10 minutos y sin cuenta: ¿tu plan de calidad se cumple igual en cada turno?</p>
        </article>
        <article class="tarjeta">
          <h3><a href={url('prompts/')}>Prompts de IA</a></h3>
          <p>{totalPrompts} instrucciones listas para copiar en tu asistente de IA, sin datos de pacientes.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="seccion seccion-alt">
    <div class="contenedor">
      <div class="franja-qc">
        <div>
          <p class="antetitulo">Próximamente</p>
          <h2>ConsensusLab Accreditation</h2>
          <p>
            Ordenar la evidencia para la acreditación de tu laboratorio, a partir de las características obligatorias del
            estándar. Deja tu correo y te avisamos primero.
          </p>
        </div>
        <a class="boton" href={url('accreditation/')}>Ver y sumarme a la lista</a>
      </div>
    </div>
  </section>

  {
    ultimos.length > 0 && (
      <section class="seccion">
        <div class="contenedor">
          <div class="seccion-cabeza">
            <div>
              <p class="antetitulo">Opinión</p>
              <h2>Historias de laboratorio</h2>
            </div>
            <a href={url('opinion/')}>Ver todos los artículos</a>
          </div>
          <div class="rejilla">
            {ultimos.map((a) => (
              <article class="tarjeta">
                <div class="tarjeta-meta">
                  <time datetime={a.data.fecha.toISOString().slice(0, 10)}>{formatoFecha(a.data.fecha)}</time>
                </div>
                <h3><a href={url(`opinion/${a.id}/`)}>{a.data.titulo}</a></h3>
                <p>{a.data.resumen}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="seccion seccion-alt">
    <div class="contenedor">
      <div class="independencia">
        <div>
          <p class="antetitulo">Independencia</p>
          <h2>Sin conflicto de interés</h2>
          <p>
            Un software que vende controles de calidad no es neutro frente a esos controles. ConsensusLab no vende controles,
            analizadores, equipos ni reactivos, y no cobra comisiones de proveedores: ninguna decisión te empuja hacia una marca.
          </p>
        </div>
        <a class="boton" href={url('acerca/')}>Quién lo prepara</a>
      </div>
    </div>
  </section>
</Base>
