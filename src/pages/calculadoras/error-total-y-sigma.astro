---
import PaginaCalculadora from '../../componentes/PaginaCalculadora.astro';
import { url } from '../../lib/rutas';
---

<PaginaCalculadora id="error-total-y-sigma">
  <form class="calc" id="calc" novalidate>
    <div class="calc-campos">
      <label class="calc-campo">
        <span>Error total permitido (TEa)</span>
        <span class="calc-entrada"><input class="campo" name="tea" inputmode="decimal" placeholder="10" /><em>%</em></span>
        <small>Del plan de calidad: CLIA, variabilidad biológica u otra fuente.</small>
      </label>
      <label class="calc-campo">
        <span>Sesgo</span>
        <span class="calc-entrada"><input class="campo" name="sesgo" inputmode="decimal" placeholder="2" /><em>%</em></span>
        <small>Del control externo o de una comparación con un método de referencia.</small>
      </label>
      <label class="calc-campo">
        <span>CV</span>
        <span class="calc-entrada"><input class="campo" name="cv" inputmode="decimal" placeholder="2" /><em>%</em></span>
        <small>Del control interno, idealmente de un mes o más.</small>
      </label>
    </div>
  </form>

  <section class="calc-resultado" aria-live="polite">
    <p class="calc-mensaje" data-mensaje>Ingresa el TEa, el sesgo y el CV.</p>
    <div data-resultado hidden>
      <div class="calc-cifras">
        <div><span>Error total</span><strong data-et></strong><small data-et-vs></small></div>
        <div><span>Sigma</span><strong data-sigma></strong><small data-categoria></small></div>
        <div><span>ΔSEcrit</span><strong data-dse></strong><small>error sistemático crítico</small></div>
      </div>
      <div class="calc-recomendacion" data-reco>
        <p><strong>Reglas de Westgard sugeridas:</strong> <span data-reglas></span></p>
        <p><strong>Controles:</strong> <span data-controles></span></p>
        <p class="calc-nota" data-nota hidden></p>
      </div>
    </div>
  </section>

  <section class="calc-diseno" data-diseno hidden>
    <h2>Diseña tu control: Ped y Pfr</h2>
    <p class="calc-ayuda">
      Mueve las metas y mira qué procedimientos de control las cumplen con tu ΔSEcrit
      (<strong data-dse-diseno></strong>).
    </p>
    <form class="calc-campos calc-metas" id="metas" novalidate>
      <label class="calc-campo">
        <span>Probabilidad de detección de error (Ped) mínima: <output data-ped-valor></output></span>
        <input type="range" name="ped" min="50" max="99" step="1" value="90" />
        <small>Qué tan seguido quieres detectar el error crítico en la primera corrida.</small>
      </label>
      <label class="calc-campo">
        <span>Probabilidad de falso rechazo (Pfr) máxima: <output data-pfr-valor></output></span>
        <input type="range" name="pfr" min="0" max="10" step="0.5" value="5" />
        <small>Qué tan seguido aceptas rechazar una corrida que estaba bien.</small>
      </label>
    </form>

    <div class="calc-resultado" aria-live="polite">
      <p class="calc-recomendado" data-recomendado></p>
      <div class="calc-tabla-envoltura">
        <table class="calc-tabla calc-tabla-poder">
          <thead>
            <tr><th>Procedimiento</th><th>Pfr</th><th>Ped</th><th>Cumple</th></tr>
          </thead>
          <tbody data-filas></tbody>
        </table>
      </div>
      <p class="calc-nota">
        Pfr y Ped calculadas para un error sistemático constante en todas las corridas evaluadas. Las reglas simples se
        calculan exactas y las multirreglas por simulación, así que pueden variar en ±0,5 %.
      </p>
    </div>
  </section>

  <div slot="explicacion">
    <h2>Cómo se calcula</h2>
    <ul>
      <li><strong>Error total</strong> = |sesgo| + 1,65 × CV (modelo de Westgard, 95 % a una cola).</li>
      <li><strong>Sigma</strong> = (TEa − |sesgo|) / CV.</li>
      <li><strong>ΔSEcrit</strong> = sigma − 1,65: el error sistemático que el control debe detectar.</li>
    </ul>
    <h2>Cómo leer la sigma</h2>
    <ul>
      <li><strong>6 o más</strong>: clase mundial. Basta una regla simple con pocos controles.</li>
      <li><strong>4 a 6</strong>: bueno a excelente. Multirregla con 2 a 4 controles por corrida.</li>
      <li><strong>3 a 4</strong>: marginal. Multirregla completa y más controles.</li>
      <li>
        <strong>Menos de 3</strong>: el control estadístico no alcanza. Conviene mejorar el método o revisar el
        requisito.
      </li>
    </ul>
    <p>
      Las reglas sugeridas siguen las «Westgard Sigma Rules» y son un punto de partida. Con «Diseña tu control» puedes
      fundamentar la elección con las funciones de poder.
    </p>
    <h2>Ped y Pfr</h2>
    <ul>
      <li>
        <strong>Ped</strong>: probabilidad de que el procedimiento rechace la corrida cuando hay un error sistemático
        igual a ΔSEcrit. Lo habitual es pedir 90 % o más.
      </li>
      <li>
        <strong>Pfr</strong>: probabilidad de rechazar una corrida sin error. Cada falso rechazo cuesta repeticiones,
        reactivos y tiempo. Lo habitual es pedir 5 % o menos.
      </li>
      <li>
        Subir la Ped exige más controles o límites más estrechos, y eso sube la Pfr. Con sigma alta ambas metas se
        cumplen con poco; con sigma baja hay que elegir cuál ceder.
      </li>
      <li>
        La calculadora recomienda el procedimiento más simple que cumple ambas metas. Consensus QC hace este mismo
        análisis con tus datos reales y sus <a href={url('consensus-qc/')}>funciones de poder</a>.
      </li>
    </ul>
  </div>
</PaginaCalculadora>

<script>
  import { categoriaSigma, disenoControl, errorSistematicoCritico, errorTotal, formato, numero, sigma } from '../../lib/calidad.js';

  const form = document.getElementById('calc') as HTMLFormElement;
  const metas = document.getElementById('metas') as HTMLFormElement;
  const $ = (s: string) => document.querySelector(`[data-${s}]`) as HTMLElement;
  let dseActual = NaN;

  function mostrarMensaje(texto: string) {
    $('mensaje').textContent = texto;
    $('mensaje').hidden = false;
    $('resultado').hidden = true;
    $('diseno').hidden = true;
  }

  // Un decimal, para que 69,7 % no se lea como 70 % y parezca cumplir una meta de 70 %.
  const pct = (p: number) => (p >= 0.9995 && p < 1 ? '> 99,9' : formato(p * 100, 1)) + ' %';

  function disenar() {
    const pedMin = Number(metas.ped.value) / 100;
    const pfrMax = Number(metas.pfr.value) / 100;
    $('ped-valor').textContent = formato(pedMin * 100, 0) + ' %';
    $('pfr-valor').textContent = formato(pfrMax * 100, 1) + ' %';
    if (!Number.isFinite(dseActual)) return;
    $('dse-diseno').textContent = formato(dseActual, 2);

    const tbody = $('filas');
    if (dseActual <= 0) {
      $('recomendado').textContent = 'Con ΔSEcrit cero o negativo el error crítico ya ocurre sin ningún cambio en el método: ningún procedimiento de control puede detectarlo a tiempo. Mejora el sesgo o el CV primero.';
      $('recomendado').dataset.nivel = 'error';
      tbody.replaceChildren();
      return;
    }
    const d = disenoControl(dseActual, pedMin, pfrMax);
    if (d.recomendado) {
      $('recomendado').innerHTML = '';
      $('recomendado').append('Recomendado: ', Object.assign(document.createElement('strong'), { textContent: d.recomendado.nombre }),
        ` (Ped ${pct(d.recomendado.ped)}, Pfr ${pct(d.recomendado.pfr)}). Es el más simple que cumple ambas metas.`);
      $('recomendado').dataset.nivel = 'ok';
    } else if (d.mejor) {
      $('recomendado').innerHTML = '';
      $('recomendado').append('Ningún procedimiento cumple ambas metas. Respetando la Pfr, el que más detecta es ',
        Object.assign(document.createElement('strong'), { textContent: d.mejor.nombre }),
        ` (Ped ${pct(d.mejor.ped)}). Baja la Ped exigida, acepta más Pfr o mejora el método.`);
      $('recomendado').dataset.nivel = 'advertencia';
    } else {
      $('recomendado').textContent = 'Ningún procedimiento tiene una Pfr tan baja. Acepta un poco más de falso rechazo.';
      $('recomendado').dataset.nivel = 'advertencia';
    }

    tbody.replaceChildren(...d.filas.map((f) => {
      const tr = document.createElement('tr');
      if (f === d.recomendado || (!d.recomendado && f === d.mejor)) tr.className = 'calc-fila-elegida';
      const celda = (texto: string, nivel?: string) => {
        const td = document.createElement('td');
        td.textContent = texto;
        if (nivel) td.dataset.nivel = nivel;
        return td;
      };
      tr.append(
        celda(f.nombre),
        celda(pct(f.pfr), f.cumplePfr ? 'ok' : 'error'),
        celda(pct(f.ped), f.cumplePed ? 'ok' : 'error'),
        celda(f.cumple ? 'Sí' : 'No', f.cumple ? 'ok' : 'error'),
      );
      return tr;
    }));
  }

  function calcular() {
    const tea = numero(form.tea.value);
    const s = numero(form.sesgo.value);
    const cv = numero(form.cv.value);
    if ([tea, s, cv].some(Number.isNaN)) return mostrarMensaje('Ingresa el TEa, el sesgo y el CV.');
    if (tea <= 0 || cv <= 0) return mostrarMensaje('El TEa y el CV deben ser mayores que cero.');

    $('mensaje').hidden = true;
    $('resultado').hidden = false;
    const et = errorTotal(s, cv);
    $('et').textContent = formato(et, 2) + ' %';
    $('et-vs').textContent = et <= tea ? `Cumple: menor o igual al TEa (${formato(tea, 2)} %)` : `No cumple: supera el TEa (${formato(tea, 2)} %)`;
    $('et-vs').dataset.nivel = et <= tea ? 'ok' : 'error';

    const sg = sigma(tea, s, cv);
    const cat = categoriaSigma(sg);
    $('sigma').textContent = formato(sg, 1);
    $('categoria').textContent = cat.texto;
    $('categoria').dataset.nivel = cat.nivel;
    dseActual = errorSistematicoCritico(tea, s, cv);
    $('dse').textContent = formato(dseActual, 2);
    $('reglas').textContent = cat.reglas;
    $('controles').textContent = cat.controles;
    $('nota').hidden = !cat.nota;
    $('nota').textContent = cat.nota ?? '';
    if (Math.abs(s) >= tea) {
      $('nota').hidden = false;
      $('nota').textContent = 'El sesgo ya iguala o supera el TEa: ningún esquema de control puede compensarlo. Corrige el sesgo (calibración, reactivo, método) antes de diseñar el control.';
    }
    $('diseno').hidden = false;
    disenar();
  }

  form.addEventListener('input', calcular);
  form.addEventListener('submit', (e) => e.preventDefault());
  metas.addEventListener('input', disenar);
  metas.addEventListener('submit', (e) => e.preventDefault());
  calcular();
  disenar();
</script>
