---
// Índice de calculadoras de calidad.
import Base from '../../plantillas/Base.astro';
import { CALCULADORAS } from '../../lib/calculadoras';
import { url } from '../../lib/rutas';
---

<Base
  titulo="Calculadoras de calidad"
  seccion="calculadoras"
  descripcion="Calculadoras gratuitas de control de calidad para laboratorio clínico: estadística del control, error total, sigma, sesgo, SDI y error total permitido."
>
  <div class="contenedor seccion">
    <h1>Calculadoras de calidad</h1>
    <p class="texto-suave intro-prompts">
      Para el día a día del control de calidad: establecer los límites de un control, saber cuánto error total tiene un
      método, elegir las reglas de Westgard o fijar el error total permitido. Gratuitas, sin registrarte, y el cálculo
      ocurre en tu navegador.
    </p>
    <div class="rejilla">
      {
        CALCULADORAS.map((c) => (
          <article class="tarjeta">
            <h3>
              <a href={url(`calculadoras/${c.id}/`)}>{c.titulo}</a>
            </h3>
            <p>{c.resumen}</p>
          </article>
        ))
      }
    </div>
    <p class="texto-suave nota-opinion">
      Las calculadoras son herramientas de apoyo: los criterios de aceptación los define el plan de calidad de tu
      laboratorio.
    </p>
  </div>
</Base>
