---
// Índice de calculadoras de calidad.
import Base from '../../plantillas/Base.astro';
import IconoFamilia from '../../componentes/IconoFamilia.astro';
import PedirDemo from '../../componentes/PedirDemo.astro';
import { CALCULADORAS, FAMILIAS, GRUPOS_ESTADISTICA } from '../../lib/calculadoras';
import { url } from '../../lib/rutas';
---

<Base
  titulo="Calculadoras para laboratorio clínico: costos, rendimiento y control de calidad"
  seccion="calculadoras"
  descripcion="Calculadoras gratuitas para laboratorio clínico: costos, control de calidad, verificación de métodos, indicadores, resultados calculados y trabajo en el banco."
>
  <div class="contenedor seccion">
    <h1>Calculadoras</h1>
    <p class="texto-suave intro-prompts">
      Para decidir con números: cuánto cuesta cada examen, cuánto rinde un reactivo, qué límites tiene un control o
      cuánto error total tiene un método. Gratuitas, sin registrarte, y el cálculo ocurre en tu navegador.
    </p>
    <label class="calc-buscador">
      <span class="visualmente-oculto">Buscar una calculadora</span>
      <input class="campo" type="search" id="buscar-calc" placeholder={`Buscar entre las ${CALCULADORAS.length} calculadoras (por ejemplo: sigma, LDL, licitación)`} autocomplete="off" />
    </label>
    <nav class="calc-familias" aria-label="Familias de calculadoras">
      {FAMILIAS.map((f) => <a href={`#${f.id}`}><IconoFamilia familia={f.id} />{f.titulo}</a>)}
    </nav>
    <p class="texto-suave" id="calc-sin-resultados" hidden>No hay calculadoras que coincidan con tu búsqueda.</p>
    {
      FAMILIAS.map((f) => (
        <section class="calc-familia" id={f.id} data-familia>
          <h2><IconoFamilia familia={f.id} />{f.titulo}</h2>
          <p class="texto-suave">{f.descripcion}</p>
          {
            f.id === 'estadistica' ? (
              <>
                <p>
                  <a class="boton boton-secundario" href={url('calculadoras/pruebas-estadisticas/')}>Guía: ¿qué prueba uso?</a>
                </p>
                {GRUPOS_ESTADISTICA.map((g) => (
                  <div data-subgrupo>
                    <h3 class="calc-subgrupo">{g.titulo}</h3>
                    <p class="texto-suave">{g.pregunta}</p>
                    <div class="rejilla">
                      {CALCULADORAS.filter((c) => c.familia === f.id && (c as { grupo?: string }).grupo === g.id).map((c) => (
                        <article class="tarjeta" data-calc data-texto={`${c.titulo} ${c.resumen} ${g.titulo}`.toLowerCase()}>
                          <h4>
                            <a href={url(`calculadoras/${c.id}/`)}>{c.titulo}</a>
                          </h4>
                          <p>{c.resumen}</p>
                        </article>
                      ))}
                    </div>
                  </div>
                ))}
              </>
            ) : (
              <div class="rejilla">
                {CALCULADORAS.filter((c) => c.familia === f.id).map((c) => (
                  <article class="tarjeta" data-calc data-texto={`${c.titulo} ${c.resumen}`.toLowerCase()}>
                    <h3>
                      <a href={url(`calculadoras/${c.id}/`)}>{c.titulo}</a>
                    </h3>
                    <p>{c.resumen}</p>
                  </article>
                ))}
              </div>
            )
          }
        </section>
      ))
    }
    <p class="texto-suave nota-opinion">
      Las calculadoras son herramientas de apoyo: los criterios de aceptación y los costos que cuentan los define el
      plan de calidad y la gestión de tu laboratorio.
    </p>
  </div>
  <PedirDemo />
</Base>

<script>
  const caja = document.getElementById('buscar-calc') as HTMLInputElement | null;
  const quitarTildes = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function filtrar() {
    const consulta = quitarTildes(caja?.value.trim() ?? '');
    const palabras = consulta.split(/\s+/).filter(Boolean);
    let visibles = 0;
    document.querySelectorAll<HTMLElement>('[data-familia]').forEach((fam) => {
      let enFamilia = 0;
      fam.querySelectorAll<HTMLElement>('[data-calc]').forEach((tarjeta) => {
        const texto = quitarTildes(tarjeta.dataset.texto ?? '');
        const coincide = palabras.every((p) => texto.includes(p));
        tarjeta.hidden = !coincide;
        if (coincide) enFamilia++;
      });
      fam.querySelectorAll<HTMLElement>('[data-subgrupo]').forEach((sub) => {
        sub.hidden = sub.querySelectorAll('[data-calc]:not([hidden])').length === 0;
      });
      fam.hidden = enFamilia === 0;
      visibles += enFamilia;
    });
    const aviso = document.getElementById('calc-sin-resultados');
    if (aviso) aviso.hidden = visibles > 0;
  }

  caja?.addEventListener('input', filtrar);
</script>
