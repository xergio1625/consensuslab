---
import PaginaCalculadora from '../../componentes/PaginaCalculadora.astro';
import { url } from '../../lib/rutas';
---

<PaginaCalculadora id="precision-del-lote">
  <form class="calc" id="calc" novalidate>
    <div class="calc-campos">
      <label class="calc-campo calc-ancho">
        <span>Resultados del lote por día o corrida</span>
        <textarea class="campo" name="datos" rows="10" placeholder="100,2&#10;99,8&#10;101,0&#10;..."></textarea>
        <small>
          Con un resultado por día (por ejemplo, 20 días): un valor por línea. Con réplicas por día: una corrida por línea y las réplicas separadas por espacios (por ejemplo, 5 días × 4 réplicas). Al menos 3 líneas.
        </small>
      </label>
      <label class="calc-campo">
        <span>CV histórico (%)</span>
        <input class="campo" name="historico" inputmode="decimal" placeholder="opcional" />
        <small>El CV intralaboratorio de lotes anteriores del mismo control.</small>
      </label>
      <label class="calc-campo">
        <span>Error total permitido (%)</span>
        <input class="campo" name="tea" inputmode="decimal" placeholder="opcional" />
      </label>
      <label class="calc-campo">
        <span>Sesgo (%)</span>
        <input class="campo" name="sesgo" inputmode="decimal" placeholder="0" />
        <small>Para la sigma de partida. En blanco se toma 0.</small>
      </label>
      <label class="calc-campo">
        <span>Nivel de confianza</span>
        <select class="campo" name="confianza">
          <option value="0.95">95 %</option>
          <option value="0.99">99 %</option>
          <option value="0.9">90 %</option>
        </select>
      </label>
    </div>
    <p class="calc-ayuda">
      <button type="button" class="boton boton-secundario calc-ejemplo" data-ejemplo="serie">Ejemplo: 20 días, 1 resultado</button>
      <button type="button" class="boton boton-secundario calc-ejemplo" data-ejemplo="replicas">Ejemplo: 5 días × 4 réplicas</button>
    </p>
  </form>

  <section class="calc-resultado" aria-live="polite">
    <p class="calc-mensaje" data-mensaje>Pega los resultados del lote (al menos 3 días).</p>
    <div data-resultado hidden>
      <p class="calc-lectura" data-lectura></p>
      <div class="calc-cifras">
        <div><span>Repetibilidad (intraserial)</span><strong data-cv-r></strong><small data-cv-r-nota></small></div>
        <div><span>Interserial (entre corridas)</span><strong data-cv-e></strong><small data-cv-e-nota></small></div>
        <div><span>Intralaboratorio</span><strong data-cv-w></strong><small data-cv-w-nota></small></div>
        <div><span>Media del lote</span><strong data-media></strong><small data-media-nota></small></div>
      </div>
      <div class="calc-tabla-envoltura">
        <table class="calc-tabla calc-tabla-texto">
          <thead><tr><th>Comparación</th><th>Valor</th><th>Lectura</th></tr></thead>
          <tbody data-filas></tbody>
        </table>
      </div>
      <p class="calc-nota" data-aviso></p>
    </div>
  </section>

  <div slot="explicacion">
    <h2>Cómo se calcula</h2>
    <ul>
      <li><strong>Con réplicas por día</strong>: ANOVA de un factor aleatorio. La repetibilidad (intraserial) es la raíz del cuadrado medio dentro de las corridas; la componente entre corridas (interserial) es √((CM entre − CM dentro) / n₀) (0 si es negativa); la precisión intralaboratorio, √(intraserial² + interserial²). Los gl del CV intralaboratorio son los de Satterthwaite.</li>
      <li><strong>Con un resultado por día</strong>: no hay réplicas, así que no se separa la repetibilidad. El CV de la serie es el CV interserial (entre días), que es el que importa para la partida de un lote nuevo.</li>
      <li><strong>Comparación con el CV histórico</strong>: se calcula un límite superior CV histórico × √(χ²(confianza; gl) / gl). Un CV observado por debajo del límite no contradice al histórico. Es unilateral: pregunta si el lote nuevo es <em>más</em> imprecisa que lo habitual.</li>
      <li><strong>Sigma de partida</strong>: σ = (error total permitido − |sesgo|) / CV. Con σ ≥ 6 el método es de clase mundial; con σ &lt; 3 es marginal o pobre y exige más controles o mejorar el método.</li>
    </ul>
    <h2>Cómo usarlo</h2>
    <ul>
      <li>Antes de fijar la media y la DE de un lote nuevo, verifica que la serie sea estable: <a href={url('calculadoras/tendencia-y-aleatoriedad/')}>sin tendencia</a>, sin <a href={url('calculadoras/valores-atipicos/')}>atípicos</a> y, si hay réplicas, con <a href={url('calculadoras/homogeneidad-entre-corridas/')}>varianzas homogéneas</a>.</li>
      <li>Con 20 resultados, el CV tiene una incertidumbre notable (alrededor de ±16 % de su valor al 95 %): no lo uses solo para decidir si «el lote es peor».</li>
      <li>El CV histórico debe ser del mismo analito, nivel y método. Un CV a un nivel bajo no es comparable con uno a un nivel alto.</li>
      <li>La partida de un lote con 20 datos es provisoria: la media y la DE se afinan con el uso acumulado del lote.</li>
      <li>Para comparar con el fabricante, <a href={url('calculadoras/comparacion-con-el-fabricante/')}>comparación con el fabricante</a>. Para comparar con el lote anterior, <a href={url('calculadoras/comparacion-de-lotes/')}>comparación de dos series</a>.</li>
    </ul>
    <h2>Referencias</h2>
    <p>CLSI EP05-A3 y EP15-A3 (componentes de varianza de la precisión). Westgard JO. <em>Basic Method Validation</em>, 3.ª ed. (sigma).</p>
  </div>
</PaginaCalculadora>

<script>
  import { categoriaSigma, formato, numero } from '../../lib/calidad.js';
  import { leerGrupos, precisionLote } from '../../lib/pruebas.js';
  import { filaTexto } from '../../lib/pruebas_ui';

  const form = document.getElementById('calc') as HTMLFormElement;
  const $ = (s: string) => document.querySelector(`[data-${s}]`) as HTMLElement;

  function mensaje(t: string) {
    $('mensaje').textContent = t;
    $('mensaje').hidden = false;
    $('resultado').hidden = true;
  }

  function calcular() {
    const grupos = leerGrupos(form.datos.value);
    if (grupos.flat().some(Number.isNaN)) return mensaje('Hay valores que no son números: revisa los datos.');
    if (grupos.length < 3) return mensaje('Pega los resultados del lote (al menos 3 días).');
    const confianza = Number(form.confianza.value);
    const sesgo = Number.isFinite(numero(form.sesgo.value)) ? numero(form.sesgo.value) : 0;
    const r = precisionLote(grupos, { cvHistorico: numero(form.historico.value), tea: numero(form.tea.value), sesgoPct: sesgo, confianza });
    if (!r) return mensaje('No se pudo calcular: los valores deben variar y la media no puede ser 0.');
    $('mensaje').hidden = true;
    $('resultado').hidden = false;

    const solo = r.soloSerie;
    $('cv-r').textContent = solo ? '—' : formato(r.cvR, 2) + ' %';
    $('cv-r-nota').textContent = solo ? 'Sin réplicas: no se estima' : `DE ${formato(r.sr, 3)} · ${r.glW} gl`;
    $('cv-e').textContent = solo ? formato(r.cvWl, 2) + ' %' : formato(r.cvEntre, 2) + ' %';
    $('cv-e-nota').textContent = solo ? `CV de la serie de ${r.N} días` : `${formato(r.pctEntre, 0)} % de la varianza total`;
    $('cv-w').textContent = formato(r.cv, 2) + ' %';
    $('cv-w-nota').textContent = `${formato(r.glWl, 1)} gl`;
    $('media').textContent = formato(r.gran, 3);
    $('media-nota').textContent = `${r.N} resultados en ${r.k} días`;

    const filas: HTMLTableRowElement[] = [];
    const lectura = $('lectura');
    let nivel: 'ok' | 'advertencia' = 'ok';
    const partes: string[] = [];
    if (Number.isFinite(r.limiteHistorico)) {
      const ok = r.dentroHistorico;
      filas.push(filaTexto(['Contra el CV histórico', `CV ${formato(r.cv, 2)} % · límite ${formato(r.limiteHistorico, 2)} % (razón ${formato(r.razonHistorico, 2)})`, ok ? 'No es más imprecisa que el histórico' : 'Más imprecisa que el histórico']));
      if (!ok) nivel = 'advertencia';
      partes.push(ok ? 'El CV es compatible con el histórico.' : 'El CV supera el límite del histórico: revisa el lote y la técnica antes de partir.');
    }
    if (Number.isFinite(r.sigmaPartida)) {
      const cat = categoriaSigma(r.sigmaPartida);
      filas.push(filaTexto(['Sigma de partida', `${formato(r.sigmaPartida, 2)} (error total permitido ${formato(Number(numero(form.tea.value)), 2)} %, sesgo ${formato(sesgo, 2)} %)`, cat?.texto ?? '']));
      if (r.sigmaPartida < 3) nivel = 'advertencia';
      partes.push(`Sigma de partida ${formato(r.sigmaPartida, 1)}.`);
    }
    $('filas').replaceChildren(...(filas.length ? filas : [filaTexto(['Indica el CV histórico o el error total permitido para comparar', '', ''])]));
    lectura.textContent = partes.length ? partes.join(' ') : `El CV ${solo ? 'interserial' : 'intralaboratorio'} del lote es ${formato(r.cv, 2)} %. Indica el CV histórico o el error total permitido para compararlo.`;
    lectura.dataset.nivel = nivel;
    $('aviso').textContent = `Con ${r.k} días el CV es una estimación aproximada: su intervalo de confianza es amplio. La partida es provisoria hasta acumular más datos.`;
  }

  const EJEMPLOS: Record<string, { datos: string; historico: string; tea: string }> = {
    serie: {
      datos: ['99,2', '100,4', '101,1', '98,7', '100,0', '99,5', '100,8', '101,3', '99,9', '100,2', '98,9', '100,6', '99,6', '100,1', '101,0', '99,3', '100,5', '99,8', '100,3', '100,9'].join('\n'),
      historico: '1,2',
      tea: '6',
    },
    replicas: {
      datos: ['100,2 99,8 101,0 100,5', '99,6 100,9 100,1 99,9', '101,2 100,4 99,7 100,8', '100,0 99,5 100,6 100,3', '99,4 100,7 100,2 99,9'].join('\n'),
      historico: '1,0',
      tea: '6',
    },
  };
  form.querySelectorAll<HTMLElement>('[data-ejemplo]').forEach((b) =>
    b.addEventListener('click', () => {
      const e = EJEMPLOS[b.dataset.ejemplo ?? 'serie'];
      form.datos.value = e.datos;
      form.historico.value = e.historico;
      form.tea.value = e.tea;
      form.sesgo.value = '';
      calcular();
    }),
  );
  form.addEventListener('input', calcular);
  form.addEventListener('change', calcular);
  form.addEventListener('submit', (e) => e.preventDefault());
  calcular();
</script>
