---
import PaginaCalculadora from '../../componentes/PaginaCalculadora.astro';
import { url } from '../../lib/rutas';
---

<PaginaCalculadora id="prueba-de-normalidad">
  <form class="calc" id="calc" novalidate>
    <div class="calc-campos">
      <label class="calc-campo calc-ancho">
        <span>Resultados</span>
        <textarea class="campo" name="datos" rows="10" placeholder="100,2&#10;99,8&#10;101,0&#10;..."></textarea>
        <small>Un valor por línea (al menos 8; con 20 o más las pruebas son más confiables).</small>
      </label>
      <label class="calc-campo">
        <span>Nivel de significancia</span>
        <select class="campo" name="alfa">
          <option value="0.05">5 % (α = 0,05)</option>
          <option value="0.01">1 % (α = 0,01)</option>
          <option value="0.1">10 % (α = 0,10)</option>
        </select>
      </label>
    </div>
    <p class="calc-ayuda">
      <button type="button" class="boton boton-secundario calc-ejemplo" data-ejemplo="normal">Ejemplo con datos normales</button>
      <button type="button" class="boton boton-secundario calc-ejemplo" data-ejemplo="asimetrico">Ejemplo con datos asimétricos</button>
    </p>
  </form>

  <section class="calc-resultado" aria-live="polite">
    <p class="calc-mensaje" data-mensaje>Pega los resultados (al menos 8).</p>
    <div data-resultado hidden>
      <p class="calc-lectura" data-lectura></p>
      <div class="calc-tabla-envoltura">
        <table class="calc-tabla calc-tabla-texto">
          <thead><tr><th>Prueba</th><th>Estadístico</th><th>Valor p</th><th>Lectura</th></tr></thead>
          <tbody data-filas></tbody>
        </table>
      </div>
      <p class="calc-nota" data-aviso></p>
      <h2>Gráfico Q-Q</h2>
      <div class="lj-envoltura" data-grafico></div>
      <p class="lj-leyenda">
        <span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="4.5" class="lj-ok"></circle></svg>Dato ordenado</span>
        <span>Línea: lo que se esperaría con una normal de igual media y DE</span>
        <span data-correlacion></span>
      </p>
    </div>
  </section>

  <div slot="explicacion">
    <h2>Cómo elegir entre las pruebas</h2>
    <ul>
      <li><strong>Shapiro-Wilk</strong> es la más potente con n pequeño: compara los datos ordenados con los que daría una normal. Es la primera opción con 20 datos.</li>
      <li><strong>Anderson-Darling</strong> da más peso a las colas: es mejor para detectar valores extremos que no encajan en la normal.</li>
      <li><strong>D’Agostino-Pearson</strong> separa la forma en <em>asimetría</em> y <em>curtosis</em> y las combina (K²). Dice por qué no son normales: si es por sesgo hacia un lado o por colas pesadas. Con menos de 20 datos la curtosis es poco confiable.</li>
      <li><strong>Lilliefors</strong> es la prueba de Kolmogorov-Smirnov corregida porque la media y la DE se estiman de los mismos datos. Es la menos potente de las cuatro: no la uses sola.</li>
      <li><strong>Gráfico Q-Q</strong>: si los puntos siguen la recta, los datos son compatibles con una normal. Curvas en los extremos indican colas distintas; una curva en «S» o en «C», asimetría. Es la inspección que no debes omitir.</li>
    </ul>
    <h2>Cómo usarlo</h2>
    <ul>
      <li>Un valor p pequeño (por debajo de α) significa que hay evidencia contra la normalidad. Un valor p grande <em>no prueba</em> normalidad: con 20 datos, estas pruebas detectan solo desvíos grandes.</li>
      <li>Con n pequeño, mira a la vez las pruebas y el gráfico. Si discrepan, manda el gráfico más el conocimiento del analito.</li>
      <li>Un solo valor atípico puede hacer fracasar la normalidad: revisa los <a href={url('calculadoras/valores-atipicos/')}>valores atípicos</a> antes, pero sin excluir sin causa asignable.</li>
      <li>Si los datos no son normales, prefiere pruebas sin esa suposición: Tukey y Hampel para atípicos, Mann-Kendall y Cox-Stuart para tendencia, Levene o Brown-Forsythe para varianzas.</li>
    </ul>
    <h2>Referencias</h2>
    <p>
      Shapiro SS, Wilk MB. <em>Biometrika</em> 1965;52:591-611; algoritmo de Royston P. <em>Appl Stat</em> 1992;41:117-119 (AS R94, verificado con el ejemplo de 11 datos de Shapiro y Wilk: W = 0,789, p = 0,0067).
      D’Agostino RB, Stephens MA. <em>Goodness-of-Fit Techniques</em>, 1986 (Anderson-Darling con parámetros estimados). D’Agostino RB, Belanger A, D’Agostino RB Jr. <em>Am Stat</em> 1990;44:316-321 (K²).
      Dallal GE, Wilkinson L. <em>Am Stat</em> 1986;40:294-296 (valor p de Lilliefors).
    </p>
  </div>
</PaginaCalculadora>

<script>
  import { formato, valores } from '../../lib/calidad.js';
  import { escala, GEOMETRIA, ejes, lienzo, svg } from '../../lib/graficos.js';
  import { andersonDarling, dagostinoPearson, lilliefors, qqNormal, shapiroWilk } from '../../lib/pruebas.js';
  import { pintarPruebas, textoSerie, type FilaPrueba } from '../../lib/pruebas_ui';

  const form = document.getElementById('calc') as HTMLFormElement;
  const $ = (s: string) => document.querySelector(`[data-${s}]`) as HTMLElement;

  function mensaje(t: string) {
    $('mensaje').textContent = t;
    $('mensaje').hidden = false;
    $('resultado').hidden = true;
  }

  function grafico(q: NonNullable<ReturnType<typeof qqNormal>>) {
    const s = lienzo(`Gráfico Q-Q normal de ${q.n} datos con correlación ${formato(q.r, 3)}.`);
    const xs = q.puntos.map((p) => p.teorico);
    const ys = q.puntos.map((p) => p.valor);
    const ex = escala(Math.min(...xs, -2), Math.max(...xs, 2), 6);
    const ey = escala(Math.min(...ys, q.media + q.de * ex.ini), Math.max(...ys, q.media + q.de * ex.fin), 5);
    const { X, Y } = ejes(s, ex, ey, 'Cuantil normal esperado (en DE)', 'Dato ordenado', GEOMETRIA);
    s.append(svg('line', { x1: X(ex.ini), y1: Y(q.media + q.de * ex.ini), x2: X(ex.fin), y2: Y(q.media + q.de * ex.fin), class: 'lj-media' }));
    q.puntos.forEach((p) => s.append(svg('circle', { cx: X(p.teorico), cy: Y(p.valor), r: 4, class: 'lj-ok', opacity: 0.8 })));
    $('grafico').replaceChildren(s);
    $('correlacion').textContent = `Correlación del gráfico: r = ${formato(q.r, 3)}`;
  }

  function calcular() {
    const datos = valores(form.datos.value);
    if (datos.some(Number.isNaN)) return mensaje('Hay valores que no son números: revisa los datos.');
    if (datos.length < 8) return mensaje('Pega los resultados (al menos 8).');
    const alfa = Number(form.alfa.value);
    const sw = shapiroWilk(datos);
    if (!sw) return mensaje('No se pudo calcular: los valores deben variar.');
    const ad = andersonDarling(datos);
    const dp = dagostinoPearson(datos);
    const li = lilliefors(datos);
    const q = qqNormal(datos);
    $('mensaje').hidden = true;
    $('resultado').hidden = false;

    const veredicto = (p: number | undefined) => (p !== undefined && p < alfa ? 'Se rechaza la normalidad' : 'No se rechaza la normalidad');
    const nivel = (p: number | undefined) => (p !== undefined && p < alfa ? 'advertencia' : 'ok') as FilaPrueba['nivel'];
    const filas: FilaPrueba[] = [
      { prueba: 'Shapiro-Wilk', que: 'La más potente con n pequeño', estadistico: `W = ${formato(sw.w, 4)}`, p: sw.p, lectura: veredicto(sw.p), nivel: nivel(sw.p) },
      ad
        ? { prueba: 'Anderson-Darling', que: 'Sensible a las colas', estadistico: `A²* = ${formato(ad.a, 3)}`, p: ad.p, lectura: veredicto(ad.p), nivel: nivel(ad.p) }
        : { prueba: 'Anderson-Darling', que: 'Sensible a las colas', estadistico: '—', lectura: 'No se pudo calcular', nivel: 'ok' },
      dp
        ? { prueba: 'D’Agostino-Pearson', que: 'Asimetría y curtosis', estadistico: `K² = ${formato(dp.k2, 3)} (asimetría ${formato(dp.asimetria, 2)}; curtosis ${formato(dp.curtosis, 2)})`, p: dp.p, lectura: veredicto(dp.p), nivel: nivel(dp.p) }
        : { prueba: 'D’Agostino-Pearson', que: 'Asimetría y curtosis', estadistico: '—', lectura: 'No se pudo calcular', nivel: 'ok' },
      li
        ? { prueba: 'Lilliefors', que: 'Kolmogorov-Smirnov corregida', estadistico: `D = ${formato(li.d, 4)}`, p: li.p, lectura: veredicto(li.p), nivel: nivel(li.p) }
        : { prueba: 'Lilliefors', que: 'Kolmogorov-Smirnov corregida', estadistico: '—', lectura: 'No se pudo calcular', nivel: 'ok' },
    ];
    pintarPruebas($('filas'), filas);

    const rechazos = filas.filter((f) => f.nivel === 'advertencia').length;
    const lectura = $('lectura');
    if (rechazos === 0) {
      lectura.textContent = `Ninguna de las pruebas rechaza la normalidad (α = ${formato(alfa, 2)}). La media y la DE son una descripción razonable, pero con ${datos.length} datos solo se detectan desvíos grandes: confirma con el gráfico Q-Q.`;
      lectura.dataset.nivel = 'ok';
    } else {
      lectura.textContent = `${rechazos} de 4 pruebas rechazan la normalidad (α = ${formato(alfa, 2)}). Mira el gráfico Q-Q para ver dónde se desvían los datos y revisa si hay valores atípicos o dos poblaciones mezcladas.`;
      lectura.dataset.nivel = 'advertencia';
    }
    $('aviso').textContent =
      datos.length < 20
        ? 'Con menos de 20 datos la prueba de curtosis de D’Agostino-Pearson es poco confiable y todas las pruebas tienen poca potencia.'
        : 'Un valor p grande no prueba normalidad: solo indica que no hay evidencia en contra.';
    if (q) grafico(q);
  }

  const EJEMPLOS: Record<string, number[]> = {
    normal: [99.2, 100.4, 101.1, 98.7, 100.0, 99.5, 100.8, 101.3, 99.9, 100.2, 98.9, 100.6, 99.6, 100.1, 101.0, 99.3, 100.5, 99.8, 100.3, 100.9],
    asimetrico: [98.1, 98.4, 98.6, 98.9, 99.0, 99.2, 99.3, 99.5, 99.7, 99.9, 100.2, 100.4, 100.9, 101.5, 102.4, 103.6, 105.2, 107.5, 110.9, 116.0],
  };
  form.querySelectorAll<HTMLElement>('[data-ejemplo]').forEach((b) =>
    b.addEventListener('click', () => {
      form.datos.value = textoSerie(EJEMPLOS[b.dataset.ejemplo ?? 'normal'], 1);
      calcular();
    }),
  );
  form.addEventListener('input', calcular);
  form.addEventListener('change', calcular);
  form.addEventListener('submit', (e) => e.preventDefault());
  calcular();
</script>
