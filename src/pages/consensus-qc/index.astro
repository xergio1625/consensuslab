---
// Sección del software Consensus QC (absorbe el sitio consensus-qc-site).
import Base from '../../plantillas/Base.astro';
import TarjetaHerramienta from '../../componentes/TarjetaHerramienta.astro';
import EspacioVideo from '../../componentes/EspacioVideo.astro';
import { VIDEOS } from '../../lib/videos';
import { obtenerHerramientas } from '../../lib/datos';
import { RELACION_CONSENSUS_QC, url } from '../../lib/rutas';
import { urlModulo } from '../../lib/sitio';

const relacionadas = (await obtenerHerramientas()).filter((h) => h.data.consensus_qc !== 'no');

// Módulos de la versión web (la oficial desde octubre de 2026). Todos se pueden probar en la demo.
// Mantener alineado con los módulos reales de cclab-sheets: no anunciar lo que la demo no tiene.
const modulos = [
  ['Configuración', 'Analizadores con su ciclo de vida (instalado, operativo, detenido, en mantención, retirado), analitos, materiales de control y lotes con las metas del fabricante.'],
  ['Plan de calidad', 'Un plan por analito con su requisito de calidad (error total permitido de CLIA 2024 o variabilidad biológica), una táctica de control por analizador y versiones con aprobación e historial.'],
  ['Funciones de poder', 'Probabilidad de detectar un error (Ped) y de falso rechazo (Pfr) de cada táctica, para elegir las reglas de Westgard y el número de controles con fundamento.'],
  ['Registro N20', 'Estudio de 20 mediciones por nivel para establecer la media y la DE propias de cada lote antes de usarlo.'],
  ['Controles diarios', 'Ingreso de los controles por corrida con las reglas de Westgard evaluadas al instante y los controles que exige la táctica vigente.'],
  ['Cumplimiento diario', 'Para cada día, qué analizador y analito cumplió con las corridas y controles que exige su táctica.'],
  ['Levey-Jennings', 'Un gráfico por nivel con ±1, 2 y 3 DE, puntos coloreados según la regla de Westgard y la marca de cada no conformidad.'],
  ['Control externo', 'Programas, rondas y resultados por analizador con SDI y porcentaje de desviación, e historial por analito.'],
  ['Desempeño', 'Mes a mes por analizador y analito: CV, sesgo, error total frente al permitido, sigma y cartas de decisión.'],
  ['No conformidades', 'Desde un control rechazado: análisis de causa, impacto en pacientes, acciones con responsable y plazo, y cierre con verificación de eficacia.'],
];
---

<Base
  titulo="Consensus QC: software de control de calidad para laboratorio clínico"
  seccion="consensus-qc"
  datos={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Consensus QC',
    description: 'Software web de control de calidad analítico para laboratorio clínico: reglas de Westgard, Levey-Jennings, sigma, plan de calidad, estudios N20, control externo y no conformidades.',
    url: new URL(Astro.url.pathname, Astro.site).href,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    inLanguage: 'es',
    publisher: { '@type': 'Organization', name: 'ConsensusLab', url: Astro.site?.href },
  }}
  descripcion="Consensus QC: software de control de calidad para laboratorio clínico con Westgard, Levey-Jennings, sigma, control externo y plan de calidad."
>
  <section class="portada">
    <div class="contenedor">
      <p class="antetitulo">Software de control de calidad</p>
      <h1>Consensus QC: el plan de calidad en el centro de tu laboratorio</h1>
      <p class="portada-lema">
        Integra el plan de calidad con el control QC diario para detectar la causa raíz de cada desviación. Funciona en
        el navegador, sin instalar nada. Automatiza parte de las herramientas de ConsensusLab, pero ninguna herramienta
        del sitio depende de él.
      </p>
      <div class="acciones-portada">
        <a class="boton boton-dorado" href={urlModulo('consensusqc')} target="_blank" rel="noopener">Probar la demo en línea</a>
      </div>
      <p class="nota-portada">
        Gratis, con tu cuenta de ConsensusLab (te llega un código al correo). La demo es compartida, usa datos ficticios
        y se restablece cada noche.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <EspacioVideo titulo="Consensus QC en funcionamiento" texto="Recorrido por la versión web de Consensus QC." {...VIDEOS['consensus-qc']} />
      <h2>Qué incluye</h2>
      <p class="texto-suave">Estos son los módulos de la versión web. Todos se pueden probar en la demo en línea.</p>
      <ul class="lista-modulos">
        {
          modulos.map(([nombre, texto]) => (
            <li>
              <strong>{nombre}</strong>
              <span>{texto}</span>
            </li>
          ))
        }
      </ul>
      <h2>Cómo funciona</h2>
      <ul class="lista-simple lista-como">
        <li>
          <strong>En el navegador.</strong> Se usa desde el computador del laboratorio o la oficina, sin instalar programas
          ni depender de un equipo en particular. La versión web es la versión oficial de Consensus QC.
        </li>
        <li>
          <strong>El plan manda.</strong> El requisito de calidad y la táctica de cada analizador definen qué reglas y
          cuántos controles se exigen en cada corrida; el resto de los módulos se ordena alrededor de eso.
        </li>
        <li>
          <strong>Trazable.</strong> Las no conformidades nacen del control que las originó y guardan su bitácora hasta el
          cierre; los registros no se borran.
        </li>
      </ul>
      <p class="texto-suave">
        En desarrollo: suscripción por laboratorio con datos propios (hoy la demo es compartida), registro de
        calibraciones, monitor por analizador, inventario de reactivos y registro de mantenciones.
      </p>
    </div>
  </section>

  {
    relacionadas.length > 0 && (
      <section class="seccion seccion-alt">
        <div class="contenedor">
          <h2>Herramientas del catálogo que cubre Consensus QC</h2>
          <p class="texto-suave">
            {Object.entries(RELACION_CONSENSUS_QC)
              .filter(([k]) => k !== 'no')
              .map(([, v]) => v)
              .join(' · ')}
          </p>
          <div class="rejilla">
            {relacionadas.map((h) => (
              <TarjetaHerramienta herramienta={h} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="seccion">
    <div class="contenedor">
      <div class="franja-qc">
        <div>
          <h2>Pronto, incluido en la suscripción</h2>
          <p>Consensus QC formará parte de los planes de suscripción de ConsensusLab.</p>
        </div>
        <a class="boton" href={url('planes/')}>Ver planes</a>
      </div>
    </div>
  </section>
</Base>
