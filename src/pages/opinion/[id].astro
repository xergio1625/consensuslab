---
// Página de un artículo de opinión: resumen propio (cuerpo del .md) y enlace al texto completo en Medium.
// Los suscriptores lo leen completo sin costo desde la app (enlace de amigo, que nunca va en este sitio).
import { render } from 'astro:content';
import Base from '../../plantillas/Base.astro';
import { obtenerOpinion } from '../../lib/datos';
import { formatoFecha, migasLd, url } from '../../lib/rutas';
import { URL_APP } from '../../lib/sitio';

export async function getStaticPaths() {
  const articulos = await obtenerOpinion();
  return articulos.map((articulo) => ({ params: { id: articulo.id }, props: { articulo } }));
}

const { articulo } = Astro.props;
const a = articulo.data;
const { Content } = await render(articulo);
const tieneResumen = Boolean(articulo.body?.trim());
const direccion = new URL(Astro.url.pathname, Astro.site).href;
const otros = (await obtenerOpinion()).filter((x) => x.id !== articulo.id).slice(0, 3);
---

<Base
  titulo={a.titulo}
  seccion="opinion"
  descripcion={a.resumen}
  indexar={tieneResumen}
  datos={[
    {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: a.titulo,
      description: a.resumen,
      datePublished: a.fecha.toISOString().slice(0, 10),
      author: { '@type': 'Person', name: 'Sergio Inostroza' },
      publisher: { '@type': 'Organization', name: 'ConsensusLab', url: Astro.site?.href },
      mainEntityOfPage: direccion,
      inLanguage: 'es',
      keywords: a.temas.join(', '),
    },
    migasLd(Astro.site, [['Opinión', 'opinion/'], [a.titulo, `opinion/${articulo.id}/`]]),
  ]}
>
  <div class="contenedor">
    <nav class="migas" aria-label="Ruta de navegación">
      <ol>
        <li><a href={url('opinion/')}>Opinión</a></li>
        <li aria-current="page">{a.titulo}</li>
      </ol>
    </nav>

    <header class="ficha-cabeza">
      <h1>{a.titulo}</h1>
      <div class="ficha-meta">
        <time datetime={a.fecha.toISOString().slice(0, 10)}>{formatoFecha(a.fecha)}</time>
        <span>· Sergio Inostroza</span>
        {a.temas.length > 0 && <span>· {a.temas.join(' · ')}</span>}
      </div>
    </header>

    <div class="ficha">
      <article class="ficha-cuerpo prosa">
        {tieneResumen ? <Content /> : <p>{a.resumen}</p>}
        <div class="caja-articulo">
          <p><strong>Este es un resumen.</strong> El artículo completo está publicado en Medium.</p>
          <div class="acciones-articulo">
            <a class="boton boton-primario" href={a.enlace} target="_blank" rel="noopener">Leer el artículo completo en Medium</a>
            <a class="boton boton-secundario" href={`${URL_APP}?articulo=${articulo.id}`} target="_blank" rel="noopener">
              Tengo suscripción: leerlo sin costo
            </a>
          </div>
          <p class="texto-suave">
            Con una suscripción a ConsensusLab lees los artículos completos sin pagar Medium, desde la app.{' '}
            <a href={url('planes/')}>Ver planes</a>.
          </p>
        </div>
        <p class="texto-suave nota-opinion">Las opiniones de este artículo son personales y no representan a ninguna institución.</p>
      </article>

      {
        otros.length > 0 && (
          <aside class="ficha-lateral">
            <div class="caja">
              <h2>Otros artículos</h2>
              <ul class="lista-simple">
                {otros.map((o) => (
                  <li>
                    <a href={url(`opinion/${o.id}/`)}>{o.data.titulo}</a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</Base>
