---
// Entrada a los planes: solo elige el perfil. Los planes de profesionales (/planes/professional/) y los de laboratorios
// (/planes/laboratorios/) viven en páginas separadas y nunca se muestran juntos.
// Los enlaces antiguos con ancla (/planes/#profesional, /planes/#plan-qc, /planes/#cotizar…) se reenvían a la página que corresponde.
import Base from '../plantillas/Base.astro';
import FondoPortada from '../componentes/FondoPortada.astro';
import { url } from '../lib/rutas';
import { MESES_PRUEBA_PROFESSIONAL, PRECIO_PROFESSIONAL_TEXTO } from '../lib/sitio';

const rutaPro = url('planes/professional/');
const rutaLab = url('planes/laboratorios/');
---

<Base
  titulo="Planes de ConsensusLab"
  seccion="planes"
  descripcion="Planes de ConsensusLab: Professional para profesionales de laboratorio y planes Essential y QC para laboratorios clínicos. Elige el tuyo."
>
  <section class="portada portada-compacta">
    <FondoPortada motivo="control" />
    <div class="contenedor">
      <p class="antetitulo">Planes</p>
      <h1>¿Para quién es el plan?</h1>
      <p class="portada-lema">
        Hay un plan para ti, como profesional de laboratorio, y planes para tu laboratorio. Elige el que buscas.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="planes planes-fila planes-entrada">
        <article class="plan plan-destacado" id="para-profesionales">
          <span class="plan-cinta">{MESES_PRUEBA_PROFESSIONAL} meses gratis</span>
          <h2><a href={rutaPro}>Para mí, como profesional</a></h2>
          <p class="plan-para">ConsensusLab Professional</p>
          <p class="plan-sirve">
            Rondas de control externo de tu criterio, respuesta experta, comparación anónima con el grupo y certificado de
            participación. Tu cuenta es tuya.
          </p>
          <p class="plan-precio">
            <span class="plan-precio-fundador">{PRECIO_PROFESSIONAL_TEXTO}</span>
            <span class="plan-precio-nota">al año, IVA incluido</span>
          </p>
          <a class="boton boton-primario boton-ancho" href={rutaPro}>Ver el plan para profesionales</a>
        </article>
        <article class="plan" id="para-laboratorios">
          <h2><a href={rutaLab}>Para mi laboratorio</a></h2>
          <p class="plan-para">Essential y ConsensusLab QC</p>
          <p class="plan-sirve">
            Registros trazables, equipos, reactivos y el plan de calidad analítico aplicado igual en cada turno. Prueba gratis
            15 días con los datos de tu laboratorio.
          </p>
          <p class="plan-precio">
            <span class="plan-precio-nota">Preventa fundadores: 40 % de descuento hasta el 1 de diciembre de 2026</span>
          </p>
          <a class="boton boton-primario boton-ancho" href={rutaLab}>Ver los planes para laboratorios</a>
        </article>
      </div>
      <p class="texto-suave">
        ¿No sabes cuál? Haz el <a href={url('diagnostico/')}>diagnóstico de tu laboratorio</a> (12 preguntas, sin cuenta). Las
        calculadoras, los prompts y las guías libres son gratuitos.
      </p>
    </div>
  </section>

  <script define:vars={{ rutaPro, rutaLab }}>
    // Enlaces antiguos con ancla: cada uno va a su página (el perfil de profesionales o el de laboratorios).
    function reenviar() {
      var h = location.hash;
      if (!h) return;
      var pro = h === '#profesional' || h === '#professional' || h === '#plan-professional';
      location.replace((pro ? rutaPro : rutaLab) + (pro ? '' : h));
    }
    reenviar();
    addEventListener('hashchange', reenviar);
  </script>
</Base>
